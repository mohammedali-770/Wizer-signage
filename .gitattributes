# Normalize line endings: enforce LF for all text files.
* text=auto eol=lf

# Windows-specific scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit text types (kept LF).
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.sh    text eol=lf
*.gradle text eol=lf

# Binary assets (never diff, never normalize).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.mp3   binary
*.apk   binary
*.aab   binary
*.jar   binary
*.keystore binary
