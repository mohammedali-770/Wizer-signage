# Wizer Signage — blue/green nginx server template.
#
# active-upstreams.conf lives on a persistent named volume and is rewritten
# atomically by deploy-blue-green.sh. nginx -s reload is graceful: existing
# workers finish in-flight requests against the old slot while new workers use
# the newly selected slot.
include /etc/nginx/runtime/active-upstreams.conf;

map $uri $wizer_android_cache {
    default          "public, max-age=31536000, immutable";
    ~*/latest\.json$ "no-cache";
}

server {
    listen      80;
    listen      [::]:80;
    server_name ${APP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()" always;
    # Dashboard middleware owns script/style/fetch CSP with a request nonce.
    # This proxy policy adds only directives that compose safely with it.
    add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'" always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location ^~ /api/downloads/android/ {
        alias /usr/share/nginx/downloads/android/;
        limit_req  zone=wizer_downloads burst=10 nodelay;
        limit_conn wizer_conn 8;
        limit_except GET HEAD { deny all; }
        autoindex off;
        location ~ /\.              { deny all; }
        location ~ \.(tmp|part|swp)$ { deny all; }
        types {
            application/vnd.android.package-archive apk;
            text/plain                              sha256;
            application/json                        json;
        }
        default_type application/octet-stream;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header Cache-Control             $wizer_android_cache;
    }

    location ^~ /api/downloads/ {
        limit_req  zone=wizer_downloads burst=10 nodelay;
        limit_conn wizer_conn 8;
        proxy_pass http://api_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id      $request_id;
        proxy_set_header Connection        "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /api/auth/ {
        limit_req  zone=wizer_auth burst=10 nodelay;
        limit_conn wizer_conn 20;
        proxy_pass http://api_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header X-Request-Id      $request_id;
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_no_cache      1;
        proxy_cache_bypass  1;
    }

    location /api/ {
        limit_req  zone=wizer_api burst=60 nodelay;
        limit_conn wizer_conn 100;
        proxy_pass http://api_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header X-Request-Id      $request_id;
        proxy_set_header Connection        "";
        client_max_body_size 512m;
        proxy_request_buffering off;
        proxy_read_timeout      300s;
        proxy_send_timeout      300s;
        proxy_no_cache      1;
        proxy_cache_bypass  1;
    }

    # During a switch this upstream contains the new dashboard first and the old
    # dashboard as `backup`. A 404 for an old content-hashed chunk is retried on
    # the old slot, avoiding broken already-open pages during the drain window.
    location /_next/static/ {
        proxy_pass http://dashboard_static_upstream;
        proxy_set_header Host       $host;
        proxy_set_header Connection "";
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504 http_404;
        proxy_next_upstream_tries 2;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://dashboard_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
