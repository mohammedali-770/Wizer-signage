# =============================================================================
# Wizer Signage — Nginx server template (env-substituted)
# =============================================================================
# This is the ${APP_DOMAIN}-templated equivalent of conf.d/wizer-signage.conf.
# The official nginx image runs `envsubst` on files in /etc/nginx/templates/*.template
# at startup, writing the result to /etc/nginx/conf.d/. To use it instead of the
# static conf, in the nginx service:
#
#   environment:
#     APP_DOMAIN: "signage.example.com"
#     NGINX_ENVSUBST_FILTER: "^APP_DOMAIN$"     # ONLY substitute APP_DOMAIN, so
#                                               # nginx vars ($host, $scheme…) survive
#   volumes:
#     - ../nginx/templates:/etc/nginx/templates:ro   # (instead of conf.d)
#     - ../nginx/nginx.conf:/etc/nginx/nginx.conf:ro
#     - certbot-webroot:/var/www/certbot:ro
#     - letsencrypt:/etc/letsencrypt:ro
#
# NGINX_ENVSUBST_FILTER is REQUIRED — without it envsubst would clobber nginx
# runtime variables like $host. See docs/nginx-ssl.md.
# =============================================================================

upstream dashboard_upstream { server dashboard:3000; keepalive 32; }
upstream api_upstream       { server api:3001;       keepalive 32; }

server {
    listen      80;
    listen      [::]:80;
    server_name ${APP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()" always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location /api/ {
        proxy_pass http://api_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        client_max_body_size 512m;
        proxy_request_buffering off;
        proxy_read_timeout      300s;
        proxy_send_timeout      300s;
        # Dynamic, per-tenant API responses must never be proxy-cached, even if a
        # cache zone is introduced later. Defensive — honor upstream no-cache too.
        proxy_no_cache      1;
        proxy_cache_bypass  1;
    }

    location /_next/static/ {
        proxy_pass http://dashboard_upstream;
        proxy_set_header Host $host;
        proxy_cache_valid 200 60m;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /ws {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering     off;
        # Never compress the WebSocket upgrade/stream.
        gzip                off;
    }

    location / {
        proxy_pass http://dashboard_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
