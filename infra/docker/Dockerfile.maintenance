# =============================================================================
# Wizer Signage maintenance worker — runs the maintenance CLI on cron plus
# database backup, TLS checks and telemetry partition preparation.
#
# BUILD CONTEXT MUST BE THE REPOSITORY ROOT:
#   docker build -f infra/docker/Dockerfile.maintenance -t wizer-signage/maintenance .
# =============================================================================

FROM node:26-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@9.12.0
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN pnpm install --filter @wizer/api... --frozen-lockfile

FROM base AS build
COPY --from=deps /app /app
COPY apps/api ./apps/api
COPY packages ./packages
RUN pnpm --filter @wizer/api db:generate
RUN pnpm --filter "@wizer/api..." build
RUN pnpm --filter @wizer/api --prod deploy /app/deploy
RUN cd /app/deploy && ./node_modules/.bin/prisma generate --schema /app/apps/api/prisma/schema.prisma

FROM node:26-alpine AS runtime
ENV NODE_ENV=production
ENV MAINTENANCE_CLI=/app/dist/maintenance/maintenance.cli.js
WORKDIR /app

# crond (busybox, bundled), su-exec for unprivileged jobs, bash, PostgreSQL
# client tools (pg_dump + psql), tzdata and OpenSSL for Prisma/runtime TLS.
RUN apk add --no-cache openssl su-exec bash postgresql-client tzdata

COPY --from=build --chown=node:node /app/deploy/node_modules ./node_modules
COPY --from=build --chown=node:node /app/apps/api/dist ./dist
COPY --from=build --chown=node:node /app/apps/api/package.json ./package.json
COPY --from=build --chown=node:node /app/apps/api/prisma ./prisma

# Every shell command referenced by infra/docker/crontab must be physically
# present in this runtime image. Keep these COPY/chmod lines synchronized with
# the crontab; the static maintenance-runtime test pins that invariant.
COPY --chown=node:node scripts/backup-db.sh ./scripts/backup-db.sh
COPY --chown=node:node scripts/lib/pg-url.sh ./scripts/lib/pg-url.sh
COPY --chown=node:node scripts/check-cert-expiry.sh ./scripts/check-cert-expiry.sh
COPY --chown=node:node scripts/ensure-telemetry-partitions.sh ./scripts/ensure-telemetry-partitions.sh
COPY infra/docker/crontab /etc/crontabs/root
RUN chmod +x \
  ./scripts/backup-db.sh \
  ./scripts/check-cert-expiry.sh \
  ./scripts/ensure-telemetry-partitions.sh

COPY infra/docker/maintenance-entrypoint.sh /usr/local/bin/maintenance-entrypoint.sh
RUN chmod +x /usr/local/bin/maintenance-entrypoint.sh

HEALTHCHECK --interval=60s --timeout=5s --start-period=15s --retries=3 \
  CMD pgrep crond >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/maintenance-entrypoint.sh"]
CMD ["crond", "-f", "-l", "8"]
