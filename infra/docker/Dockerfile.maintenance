# =============================================================================
# Wizer Signage maintenance worker — runs the maintenance CLI on cron plus
# database backup, TLS checks and telemetry partition preparation.
#
# BUILD CONTEXT MUST BE THE REPOSITORY ROOT:
#   docker build -f infra/docker/Dockerfile.maintenance -t wizer-signage/maintenance .
# =============================================================================

FROM node:26-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@9.12.0
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN pnpm install --filter @wizer/api... --frozen-lockfile

FROM base AS build
COPY --from=deps /app /app
COPY apps/api ./apps/api
COPY packages ./packages
RUN pnpm --filter @wizer/api db:generate
RUN pnpm --filter "@wizer/api..." build
RUN pnpm --filter @wizer/api --prod deploy /app/deploy
RUN cd /app/deploy && ./node_modules/.bin/prisma generate --schema /app/apps/api/prisma/schema.prisma

FROM node:26-alpine AS runtime
ENV NODE_ENV=production
ENV MAINTENANCE_CLI=/app/dist/maintenance/maintenance.cli.js
WORKDIR /app

# crond (busybox, bundled), su-exec for unprivileged jobs, bash, PostgreSQL
# client tools (pg_dump + psql), tzdata and OpenSSL for Prisma/runtime TLS.
#
# rclone is here because THIS container runs the nightly backup (see
# infra/docker/crontab) and therefore runs BACKUP_OFFSITE_CMD. Without it the
# image shipped nothing that could copy a file off the host: no rclone, aws,
# curl, scp, ssh or rsync — only busybox wget and nc. That made both commands
# documented in docs/backup-restore.md exit 127 here, and left busybox
# `wget --post-file` as the only transfer path, which truncates binary payloads
# at the first NUL byte and still exits 0. A gzip dump begins 1f 8b 08 00, so
# every backup "uploaded" exactly three bytes and reported success.
# rclone is ~106 MiB — a deliberate cost, paid so the off-box copy is real.
#
# The PostgreSQL client is PINNED TO THE PRODUCTION SERVER MAJOR (17). The
# unversioned `postgresql-client` is a virtual package that resolves to the
# newest major Alpine carries, so the pin has to be explicit in both directions:
#
#   TOO NEW  — pg_dump 18 against a 17 server writes preamble parameters the
#              server does not recognize, and restore-db.sh pipes dumps into
#              `psql --set ON_ERROR_STOP=on`, so the restore aborts before a
#              single row is applied. (This is what a floating client does:
#              pg_dump 17+ emits `SET transaction_timeout = 0;`, which is why a
#              16 server rejected dumps from an unpinned client.)
#   TOO OLD  — pg_dump REFUSES outright to dump a server newer than itself:
#              "server version 17.6; pg_dump version 16.x". A 16 client against
#              the 17.6 production server produced no dump at all.
#
# The second is not hypothetical. This image shipped `postgresql16-client`
# against a 17.6 server from PR #107 until 2026-09-02, on the mistaken belief
# that production ran 16, and the nightly backup inside this container failed
# every night for it. Only the deploy-time backup kept working, because that one
# runs on the host.
#
# ON A SERVER UPGRADE, CHANGE THIS TOO — and the host client, and CI's Postgres
# service, together. maintenance-runtime.spec.ts pins this to CI's server major
# and production-preflight.sh pins the host client to this image, so a partial
# move fails loudly rather than silently producing unrestorable backups.
RUN apk add --no-cache openssl su-exec bash postgresql17-client tzdata rclone

# Maintenance runs compiled JavaScript and checked-in shell tools directly.
# npm/npx are build-only tooling and are not needed in the deployed worker.
RUN rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx

COPY --from=build --chown=node:node /app/deploy/node_modules ./node_modules
COPY --from=build --chown=node:node /app/apps/api/dist ./dist
COPY --from=build --chown=node:node /app/apps/api/package.json ./package.json
COPY --from=build --chown=node:node /app/apps/api/prisma ./prisma

# Every shell command referenced by infra/docker/crontab must be physically
# present in this runtime image. Keep these COPY/chmod lines synchronized with
# the crontab; the static maintenance-runtime test pins that invariant.
COPY --chown=node:node scripts/backup-db.sh ./scripts/backup-db.sh
COPY --chown=node:node scripts/lib/pg-url.sh ./scripts/lib/pg-url.sh
COPY --chown=node:node scripts/check-cert-expiry.sh ./scripts/check-cert-expiry.sh
COPY --chown=node:node scripts/ensure-telemetry-partitions.sh ./scripts/ensure-telemetry-partitions.sh
COPY --chown=node:node scripts/log-shipping-canary.sh ./scripts/log-shipping-canary.sh
COPY infra/docker/crontab /etc/crontabs/root
RUN chmod +x \
  ./scripts/backup-db.sh \
  ./scripts/check-cert-expiry.sh \
  ./scripts/ensure-telemetry-partitions.sh \
  ./scripts/log-shipping-canary.sh

COPY infra/docker/maintenance-entrypoint.sh /usr/local/bin/maintenance-entrypoint.sh
RUN chmod +x /usr/local/bin/maintenance-entrypoint.sh

HEALTHCHECK --interval=60s --timeout=5s --start-period=15s --retries=3 \
  CMD pgrep crond >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/maintenance-entrypoint.sh"]
CMD ["crond", "-f", "-l", "8"]
