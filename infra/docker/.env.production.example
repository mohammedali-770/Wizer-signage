# =============================================================================
# Wizer Signage — PRODUCTION environment template
# =============================================================================
# Copy to the repo-root `.env` and fill in. NEVER commit the filled-in file.
# Generate strong secrets with: openssl rand -base64 48
# =============================================================================

NODE_ENV=production
APP_DOMAIN=signage.wizer.sa
DASHBOARD_URL=https://signage.wizer.sa
NEXT_PUBLIC_API_URL=https://signage.wizer.sa/api
CORS_ORIGINS=https://signage.wizer.sa
API_HOST=0.0.0.0
API_PORT=3001
DASHBOARD_PORT=3000
TZ=UTC

# ---- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ---- Auth / security --------------------------------------------------------
JWT_ACCESS_SECRET=__generate_with_openssl_rand__
JWT_REFRESH_SECRET=__generate_with_openssl_rand__
ENCRYPTION_KEY=__generate_with_openssl_rand__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
TWO_FACTOR_ISSUER=Wizer Signage

# ---- Observability ----------------------------------------------------------
# Production API logs are JSON automatically. Set LOG_FORMAT=json only when you
# want the same representation in non-production environments.
LOG_LEVEL=info
# LOG_FORMAT=json
# Secret header value for GET /api/internal/metrics. Minimum 32 chars. When
# missing/weak the endpoint fails closed with 503.
METRICS_TOKEN=__generate_with_openssl_rand__
PERF_SLOW_MS=1000
# PERF_LOG_REQUESTS=false
# Optional only when docker-compose.log-shipping.yml is included:
# LOG_SHIPPING_ADDRESS=logs.internal.example:24224
# LOG_SHIPPING_BUFFER_LIMIT=1048576
# LOG_SHIPPING_RETRY_WAIT_SECONDS=1

# ---- Supabase storage -------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__service_role_key__
SUPABASE_ANON_KEY=__anon_key__
SUPABASE_STORAGE_BUCKET=wizer-signage

# ---- SMTP -------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=__smtp_password__
SMTP_FROM="Wizer Signage <no-reply@wizer.sa>"
SMTP_SECURE=false

# ---- Maintenance / retention ------------------------------------------------
RETENTION_DAYS=90
CONTENT_TRASH_RETENTION_DAYS=14

# ---- Backups ----------------------------------------------------------------
BACKUP_DIR=/backups

# ---- Let's Encrypt ----------------------------------------------------------
LETSENCRYPT_EMAIL=ops@wizer.sa
CERT_WARN_DAYS=21

# ---- Out-of-band monitoring -------------------------------------------------
# HEALTHCHECKS_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# ---- Maps (optional) --------------------------------------------------------
# MAP_PROVIDER=google
# MAP_API_KEY=__map_api_key__
