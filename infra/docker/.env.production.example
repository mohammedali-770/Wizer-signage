# =============================================================================
# Wizer Signage — PRODUCTION environment template
# =============================================================================
# Copy to the repo-root `.env` and fill every [REQUIRED] value before preflight.
# NEVER commit the filled-in file. Generate strong secrets with:
#     openssl rand -base64 48
# =============================================================================

# ---- Core -------------------------------------------------------------------
NODE_ENV=production
APP_DOMAIN=signage.wizer.sa
DASHBOARD_URL=https://signage.wizer.sa
NEXT_PUBLIC_API_URL=https://signage.wizer.sa/api
CORS_ORIGINS=https://signage.wizer.sa
API_HOST=0.0.0.0
API_PORT=3001
DASHBOARD_PORT=3000
TZ=UTC

# ---- Immutable registry — [REQUIRED] ----------------------------------------
# Private GHCR namespace. The host authenticates with READ-ONLY package access.
IMAGE_REGISTRY_PREFIX=ghcr.io/YOUR_GITHUB_OWNER

# ---- Database — [REQUIRED] --------------------------------------------------
# The pooled runtime URL MUST declare an explicit small Prisma pool. During a
# blue/green cutover both API slots plus maintenance can overlap; an implicit
# per-container pool can otherwise exhaust Supabase/PgBouncer connections.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=5&pool_timeout=10
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ---- Auth / security — [REQUIRED] (use 48+ random chars) --------------------
JWT_ACCESS_SECRET=__generate_with_openssl_rand__
JWT_REFRESH_SECRET=__generate_with_openssl_rand__
ENCRYPTION_KEY=__generate_with_openssl_rand__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
TWO_FACTOR_ISSUER=Wizer Signage
# SWAGGER_ENABLED=false

# ---- Observability — [REQUIRED for production acceptance] -------------------
LOG_LEVEL=info
METRICS_TOKEN=__generate_with_openssl_rand__
PERF_SLOW_MS=1000
# PERF_LOG_REQUESTS=false

# Docker's Fluentd logging driver runs from the HOST daemon, so this address is
# resolved and connected from the host, NOT from inside a container network -- a
# Compose service name looks perfectly valid here and would ship nothing,
# silently, forever. Preflight opens a TCP connection to confirm it. Production
# blue/green deploy and rollback always include both logging overlays.
# fluentd-async keeps collector downtime from preventing containers from
# starting; receipt is still verified during release acceptance, and the
# five-minute log-shipping canary is what proves delivery has not since stopped
# (see docs/observability.md).
LOG_SHIPPING_ADDRESS=logs.your-company.internal:24224
# A COUNT OF BUFFERED EVENTS, not a byte size. Left at Docker's default on
# purpose: raising it does not reduce loss during a collector outage (measured
# over a ten-second outage with 4000 lines in flight, 1048576 delivered 1092
# and 8388608 delivered 1097). The log-shipping canary is what makes loss
# visible; this ceiling is not a durability control.
LOG_SHIPPING_BUFFER_LIMIT=1048576
LOG_SHIPPING_RETRY_WAIT_SECONDS=1

# ---- Supabase storage --------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__service_role_key__
SUPABASE_ANON_KEY=__anon_key__
SUPABASE_STORAGE_BUCKET=wizer-signage
# STORAGE_LOCAL_DIR must remain unset in production.

# ---- Email — [REQUIRED in production] ---------------------------------------
# Production boot and production-preflight fail closed without live delivery
# coordinates. WHICH coordinates depends on MAIL_TRANSPORT.
#
# CHECK THIS BEFORE CHOOSING: many hosts block outbound SMTP outright.
# DigitalOcean blocks TCP 25, 465 and 587 on every Droplet by default —
# including traffic leaving via a Reserved IP — and ZeptoMail publishes no
# alternate submission port, so on a Droplet SMTP cannot work at all and the
# HTTPS transport is the only route out. Run this on the target host first:
#
#   for t in smtp.your-provider.com:587 smtp.gmail.com:587 api.zeptomail.com:443; do
#     h=${t%:*}; p=${t#*:}
#     timeout 5 bash -c "exec 3<>/dev/tcp/$h/$p" 2>/dev/null && echo "OPEN $t" || echo "BLOCKED $t"
#   done
#
# Both :587 lines BLOCKED while :443 is OPEN means the platform is blocking it,
# not your configuration. Use zeptomail-api. A blocked host on the SMTP default
# reports mail healthy and delivers nothing.
#
# An unrecognised value is REJECTED at boot rather than defaulted.
MAIL_TRANSPORT=smtp

# Required by BOTH transports — the envelope sender stamped on every message.
SMTP_FROM="Wizer Signage <no-reply@wizer.sa>"

# ---- MAIL_TRANSPORT=smtp ----
# Required when MAIL_TRANSPORT=smtp. If SMTP_USER is set, a password must be too.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=__replace_with_real_smtp_password__
SMTP_SECURE=false

# ---- MAIL_TRANSPORT=zeptomail-api ----
# Required when MAIL_TRANSPORT=zeptomail-api. Delete the SMTP_HOST/SMTP_PORT
# lines above if you use this transport; they are not read.
#
# The Send Mail token from the ZeptoMail Mail Agent's API tab. ZeptoMail issues
# the SMTP password and the API token separately — copy the one under API.
# Sending also requires the domain verified in ZeptoMail: a DKIM TXT record and
# a bounce return-path CNAME published for the sending domain.
# ZEPTOMAIL_API_KEY=__replace_with_real_zeptomail_send_mail_token__
#
# Only for a non-default ZeptoMail region. MUST be https:// — the header carries
# the API token and the body is the rendered email, including single-use
# password-reset links. Boot fails on a plaintext or malformed value.
# ZEPTOMAIL_API_URL=https://api.zeptomail.eu/v1.1/email

# ---- Maintenance / retention ------------------------------------------------
RETENTION_DAYS=90
CONTENT_TRASH_RETENTION_DAYS=14

# ---- Backups — [REQUIRED in production] -------------------------------------
BACKUP_DIR=/backups
# The backup script dumps BOTH Wizer-owned schemas: public + wizer_telemetry.
# This command receives the dump path as $1 and must copy it OFF this host.
#
# It runs in TWO filesystems: on the host at deploy time, and inside the
# maintenance container on the nightly cron schedule. Only rclone is installed
# in that image — aws, curl, scp, ssh and rsync are NOT — so a command naming
# one of those passes a manual host test and then exits 127 every night.
# Example with rclone (replace the remote/bucket):
BACKUP_OFFSITE_CMD='rclone copyto "$1" "wizer-backups:wizer/$(basename "$1")"'
# A zero exit from the copy is NOT evidence that bytes arrived. This command
# receives the same path as $1 and must print the REMOTE object's size in bytes
# as the first token of stdout; backup-db.sh compares it against the local dump
# and fails the run on mismatch. Required by production preflight.
BACKUP_OFFSITE_VERIFY_CMD='rclone size --json "wizer-backups:wizer/$(basename "$1")" | sed -n "s/.*\"bytes\":\([0-9]*\).*/\1/p"'
# BACKUP_RETENTION_DAYS=14

# Dead-man endpoint is pinged only after backup + offsite copy succeed. It must
# be externally hosted so maintenance-container death is observable.
HEALTHCHECKS_URL=https://hc-ping.com/REPLACE_WITH_REAL_CHECK_UUID

# ---- TLS --------------------------------------------------------------------
LETSENCRYPT_EMAIL=ops@wizer.sa
CERT_WARN_DAYS=21

# ---- Maps (optional) --------------------------------------------------------
# MAP_PROVIDER=google
# MAP_API_KEY=__map_api_key__
