# =============================================================================
# Wizer Signage — PRODUCTION environment template
# =============================================================================
# Copy to the repo-root `.env` (the compose files read ../../.env) and fill in.
# NEVER commit the filled-in file. Generate strong secrets with:
#     openssl rand -base64 48
# Required vars are marked [REQUIRED]; the API fails fast at boot if missing.
# =============================================================================

# ---- Core -------------------------------------------------------------------
NODE_ENV=production
# Public domain (used by nginx server_name / TLS + docs). No scheme.
APP_DOMAIN=signage.wizer.sa
# Public dashboard origin (used for links in emails).
DASHBOARD_URL=https://signage.wizer.sa
# Public API base URL baked into the dashboard client bundle at BUILD time.
# This is NOT a secret. Used as the compose build arg for the dashboard image.
# REQUIRED for a production build — must be an absolute HTTPS URL (no localhost,
# no credentials/query/fragment). The dashboard build FAILS if it is missing or
# invalid (apps/dashboard/next.config.mjs). Set it to your public API base.
NEXT_PUBLIC_API_URL=https://signage.wizer.sa/api
# Comma-separated allowed CORS origins (lock down to your dashboard origin).
# REQUIRED in production — the API refuses to start if unset, set to "*", or set
# to a non-HTTPS/localhost/malformed value (apps/api/src/config/cors.ts). Each
# entry must be an HTTPS ORIGIN only: scheme + host + optional port, no path.
CORS_ORIGINS=https://signage.wizer.sa
# Internal bind/host + ports (rarely changed). API_HOST must stay 0.0.0.0 so
# nginx can proxy to api:3001 across the Docker network.
API_HOST=0.0.0.0
API_PORT=3001
DASHBOARD_PORT=3000
TZ=UTC

# ---- Database (Supabase Postgres) — [REQUIRED] ------------------------------
# Pooled connection string used at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require
# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ---- Auth / security — [REQUIRED] (min 16 chars; use 48+) -------------------
JWT_ACCESS_SECRET=__generate_with_openssl_rand__
JWT_REFRESH_SECRET=__generate_with_openssl_rand__
ENCRYPTION_KEY=__generate_with_openssl_rand__   # encrypts 2FA secrets at rest
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
TWO_FACTOR_ISSUER=Wizer Signage
# Force-enable Swagger docs in production (default: disabled). Leave unset.
# SWAGGER_ENABLED=false

# ---- Observability ----------------------------------------------------------
# Production API logs are emitted as single-line JSON automatically. Set
# LOG_FORMAT=json only if the same structured representation is wanted outside
# production. Keep LOG_LEVEL at info unless temporarily diagnosing an incident.
LOG_LEVEL=info
# LOG_FORMAT=json
# Dedicated secret used only by GET /api/internal/metrics. Use 32+ random chars.
# The metrics guard fails closed when the token is absent or weak. The route must
# stay internal-only at the reverse proxy/firewall even though it has its own
# authentication boundary.
METRICS_TOKEN=__generate_with_openssl_rand__
# Requests slower than this threshold are warned by the existing perf logger.
PERF_SLOW_MS=1000
# PERF_LOG_REQUESTS=false
# Optional only when docker-compose.log-shipping.yml is explicitly included.
# Use a private/reachable collector endpoint; fluentd-async keeps a collector
# outage from preventing the WIZER containers from starting.
# LOG_SHIPPING_ADDRESS=logs.internal.example:24224
# LOG_SHIPPING_BUFFER_LIMIT=1048576
# LOG_SHIPPING_RETRY_WAIT_SECONDS=1

# ---- Supabase (storage; service role is SERVER-ONLY) ------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__service_role_key__   # NEVER expose to the browser
SUPABASE_ANON_KEY=__anon_key__
SUPABASE_STORAGE_BUCKET=wizer-signage            # a PRIVATE bucket

# ---- Storage local fallback (DEV ONLY — leave unset in production) ----------
# STORAGE_LOCAL_DIR=./.storage

# ---- SMTP (email alerts / invites / reports) --------------------------------
# When unset, emails are LOGGED, not sent. SMTP_PASS aliases SMTP_PASSWORD.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=__smtp_password__
SMTP_FROM="Wizer Signage <no-reply@wizer.sa>"
SMTP_SECURE=false

# ---- Maintenance / retention (Phase 10) -------------------------------------
RETENTION_DAYS=90                 # telemetry/operational data; financial kept forever
CONTENT_TRASH_RETENTION_DAYS=14

# ---- Backups ----------------------------------------------------------------
# In the maintenance container the backup volume is mounted at /backups.
BACKUP_DIR=/backups
# Snapshot pruning window for *.sql.gz files (financial records are NOT pruned).
# (the backup script reads RETENTION_DAYS unless overridden via BACKUP_RETENTION_DAYS)
# BACKUP_RETENTION_DAYS=14

# ---- Let's Encrypt (containerized certbot override) -------------------------
LETSENCRYPT_EMAIL=ops@wizer.sa
# Nightly check of the certificate the public endpoint actually SERVES; alerts
# (non-zero exit + stderr in `docker logs`) below this many days remaining.
CERT_WARN_DAYS=21

# ---- Out-of-band monitoring (STRONGLY recommended) --------------------------
# Dead-man's-switch pinged only after a SUCCESSFUL nightly backup (e.g.
# healthchecks.io). The in-app "backup overdue" alert is raised by the same
# container that performs the backup, so it cannot report its own failure —
# this is the only signal that survives that container dying. Leave unset to
# disable (not recommended in production).
# HEALTHCHECKS_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# ---- Maps (optional) --------------------------------------------------------
# MAP_PROVIDER=google
# MAP_API_KEY=__map_api_key__
