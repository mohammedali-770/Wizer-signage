# =============================================================================
# Wizer Signage — Environment Variables (example)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# See docs/environment-variables.md for a full reference of each variable.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Performance troubleshooting (all optional, safe to leave unset):
#   PERF_LOG_REQUESTS=true  -> log every request (method/path/status/ms); off by
#                              default (slow requests are warned regardless).
#   PERF_SLOW_MS=1000       -> request duration (ms) that triggers a SLOW warning.
#   PERF_LOG_QUERIES=true   -> log Prisma SQL + duration (NEVER params/values).
#   PERF_SLOW_QUERY_MS=50   -> query duration (ms) tagged as SLOW in query logs.
# PERF_LOG_REQUESTS=false
# PERF_LOG_QUERIES=false
# Public dashboard base URL — used to build links in emails (invites, resets).
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# API / Dashboard URLs & ports
# -----------------------------------------------------------------------------
# Bind address for the API. Default 0.0.0.0 so the nginx reverse proxy can
# reach it across the Docker network. Use 127.0.0.1 only for a local-only host.
API_HOST=0.0.0.0
API_PORT=3001
DASHBOARD_PORT=3000
# Public domain for nginx server_name + Let's Encrypt cert paths (no scheme).
# REQUIRED for the production Docker stack (nginx renders its config from this).
APP_DOMAIN=signage.wizer.sa
# Internal base URL the dashboard server uses to reach the API.
API_URL=http://localhost:3001
# Public base URL exposed to the browser (must be reachable from the client).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Public marketing-site + dashboard base URLs (canonical links / redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# WIZER brand (browser-exposed; safe defaults — no secrets).
NEXT_PUBLIC_COMPANY_NAME=WIZER
NEXT_PUBLIC_PRODUCT_NAME=Wizer Signage
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Marketing site / trial signups
# -----------------------------------------------------------------------------
# Self-service trial length (days) + the plan `code` assigned to new trials
# (must match a seeded plan; falls back to the cheapest active plan).
TRIAL_DAYS=14
DEFAULT_TRIAL_PLAN=starter
# Where "Book a Demo" lead notifications are sent (falls back to SMTP_FROM).
SALES_NOTIFY_EMAIL=sales@wizer.sa

# Off-box log shipping (fluentd). LOG_SHIPPING_ADDRESS is required in production
# by both the deploy and the rollback. The retry wait is a plain integer number
# of SECONDS — the compose overlays append the unit, because Docker rejects a
# bare number with "time: missing unit in duration" at container-create time.
LOG_SHIPPING_ADDRESS=logs.example.com:24224
LOG_SHIPPING_RETRY_WAIT_SECONDS=1

# -----------------------------------------------------------------------------
# Database / Supabase
# -----------------------------------------------------------------------------
# Pooled connection string (PgBouncer) for runtime queries.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wizer_signage?schema=public
# Direct (non-pooled) connection string for migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/wizer_signage?schema=public
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Private Storage bucket for content files (Phase 4). Create it in Supabase Storage.
SUPABASE_STORAGE_BUCKET=media
# Local dev fallback storage dir (used only when Supabase Storage is not configured).
STORAGE_LOCAL_DIR=.storage

# -----------------------------------------------------------------------------
# Auth / JWT / Session  (REQUIRED — secrets must be >= 16 chars)
# -----------------------------------------------------------------------------
# Generate strong values, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
# Symmetric key used to encrypt secrets at rest (TOTP secrets). REQUIRED.
# Generate with `openssl rand -base64 32`.
ENCRYPTION_KEY=change-me-encryption-key-min-16-chars
# Issuer label shown in authenticator apps for 2FA.
TWO_FACTOR_ISSUER=Wizer Signage

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Which transport carries outbound mail: "smtp" (default) or "zeptomail-api".
# An unrecognised value is REJECTED at boot rather than coerced, because a typo
# would silently select SMTP and — on a host that blocks it — fail every send
# while the service still reported itself configured.
#
# Choose zeptomail-api when the host blocks outbound SMTP. DigitalOcean blocks
# TCP 25, 465 and 587 on every Droplet by default (including traffic via a
# Reserved IP), and ZeptoMail publishes no alternate submission port, so on a
# Droplet the HTTPS API is the only route out unless support lifts the block.
# Confirm with:  timeout 5 bash -c 'exec 3<>/dev/tcp/smtp.zeptomail.com/587'
MAIL_TRANSPORT=smtp

# Required for every transport — the envelope sender stamped on the message.
SMTP_FROM="Wizer Signage <no-reply@wizer.sa>"

# --- MAIL_TRANSPORT=smtp ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-password
SMTP_SECURE=false

# --- MAIL_TRANSPORT=zeptomail-api ---
# The Send Mail token from the ZeptoMail Mail Agent (Configuration -> API).
# ZeptoMail documents the SMTP password and the API token separately, so do not
# assume the SMTP token works here — copy the one shown on the API tab.
# ZEPTOMAIL_API_KEY=
# Only needed for a non-default ZeptoMail region (e.g. api.zeptomail.eu).
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# -----------------------------------------------------------------------------
# Data retention / maintenance (Phase 10)
# -----------------------------------------------------------------------------
# Retention window (days) for telemetry/operational data. Financial records are
# never deleted. Run cleanup via cron: maintenance.cli.js all
RETENTION_DAYS=90
CONTENT_TRASH_RETENTION_DAYS=14
BACKUP_DIR=./backups

# -----------------------------------------------------------------------------
# Production deployment — REQUIRED by scripts/production-preflight.sh
# -----------------------------------------------------------------------------
# Everything below is unused in development and mandatory in production. It is
# listed here because preflight refuses to deploy without it, and a value that
# is absent from this template is discovered one failed run at a time.

# Immutable image namespace. Releases are pulled by 12-char SHA tag, never by
# `latest`. Must match ^ghcr\.io/<owner>. The application host authenticates to
# GHCR with a READ-ONLY package credential; it must not hold registry write.
IMAGE_REGISTRY_PREFIX=ghcr.io/mohammedali-770

# Bearer token for the private Prometheus endpoint. Minimum 32 characters.
# The endpoint is reachable only over the private Compose network at
# api:3001 — the public Nginx edge returns 404 for every spelling of it.
METRICS_TOKEN=

# Off-box backup copy. Receives the dump path as "$1". A backup that exists only
# on this host is not a backup: losing the droplet loses the database and every
# snapshot with it.
#
# The command runs in TWO filesystems — on the host at deploy time, and inside
# the maintenance container on the nightly cron — so anything it names must
# exist in both. Dockerfile.maintenance installs `rclone` for exactly this
# reason. `aws`, `curl`, `scp`, `ssh` and `rsync` are NOT in that image, and
# preflight resolves the first word against it so a command that works when
# tested by hand cannot go on to fail silently every night.
#
# A LOCAL COPY IS REJECTED. `cp "$1" /backups/offsite/` satisfies every other
# gate -- the binary exists in the image, it exits 0, and the verified byte
# count matches the local dump exactly -- while leaving both copies on the same
# machine. Production ran that way until 2026-09-09. Preflight now refuses `cp`,
# `mv`, `install`, `ln` and `dd` anywhere in the command, not only as its first
# word, because the real command was `mkdir -p ... && cp ...`. If one of those
# genuinely targets a network mount, set ALLOW_LOCAL_OFFSITE_BACKUP=1.
#
# The rclone remote is configured entirely through RCLONE_CONFIG_* variables
# below: the maintenance container mounts only the backups volume and receives
# its configuration from this file, so there is no rclone.conf for it to read.
BACKUP_OFFSITE_CMD='rclone copyto "$1" "spaces:wizer-backups/$(basename "$1")"'

# Proof the copy arrived. Receives the same dump path as "$1" and must print the
# REMOTE object's size in bytes as the first token of stdout; backup-db.sh
# compares it against the local dump and fails the run on any mismatch.
#
# This is separate from the copy because a zero exit is not evidence that bytes
# arrived. Observed for real: busybox `wget --post-file` truncated a gzip dump at
# its first NUL byte — a 942-byte backup became a 3-byte remote object — and
# still exited 0, so the run reported success, pinged the dead-man switch and
# pruned the older local copies.
# The parse tolerates whitespace and pretty-printing around the value, and
# requires at least one digit: rclone's JSON layout is not guaranteed across
# versions, and a regex matching only digits flush against the colon emits an
# empty string on `"bytes": 942`. backup-db.sh rejects that as a missing byte
# count, so every backup would be reported FAILED even though the copy
# succeeded. With no `bytes` field at all it still matches nothing and fails
# closed, which is the correct outcome.
BACKUP_OFFSITE_VERIFY_CMD='rclone size --json "spaces:wizer-backups/$(basename "$1")" | sed -n "s/.*\"bytes\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p"'

# rclone remote used by the two commands above, defined as environment rather
# than as a config file. RCLONE_CONFIG_<REMOTE>_<KEY> is rclone's own mechanism
# and needs no rclone.conf, which matters because the maintenance container that
# runs the nightly backup mounts only the backups volume and gets everything
# else from this file. The remote name here (SPACES) is what `spaces:` above
# resolves to; keep the two in step if you rename it.
#
# ENDPOINT is region-specific and must NOT include the bucket name or a scheme.
# ACL private keeps the objects unreadable without the key -- these are full
# database dumps.
RCLONE_CONFIG_SPACES_TYPE=s3
RCLONE_CONFIG_SPACES_PROVIDER=DigitalOcean
RCLONE_CONFIG_SPACES_ENDPOINT=fra1.digitaloceanspaces.com
RCLONE_CONFIG_SPACES_ACL=private
RCLONE_CONFIG_SPACES_ACCESS_KEY_ID=
RCLONE_CONFIG_SPACES_SECRET_ACCESS_KEY=

# REQUIRED with a bucket-scoped key, which is the kind you should be using.
#
# Before uploading, rclone checks that the destination bucket exists, and that
# check calls ListBuckets — an ACCOUNT-level operation a key scoped to one
# bucket never has, regardless of its read/write permission. When the check
# fails rclone assumes the bucket is missing and tries CreateBucket, which is
# also denied, so the upload dies with:
#
#   api error AccessDenied: Access Denied   (operation error S3: CreateBucket)
#
# That error names CreateBucket, not PutObject, so it reads like a permissions
# problem with the key and sends you off rotating credentials that were fine.
# Setting this skips the existence check and PUTs the object directly.
#
# Verified against DigitalOcean Spaces on 2026-09-09: identical read/write key,
# failing before this was set and succeeding after.
RCLONE_CONFIG_SPACES_NO_CHECK_BUCKET=true

# Dead-man switch, pinged ONLY after a verified successful backup (e.g. a
# healthchecks.io URL). The in-app "backup overdue" alert is raised by the same
# container that takes the backup, so it cannot report its own death; this is
# the out-of-band signal that backups have stopped entirely.
HEALTHCHECKS_URL=

# -----------------------------------------------------------------------------
# Map provider
# -----------------------------------------------------------------------------
MAP_PROVIDER=maptiler
MAP_API_KEY=your-map-api-key

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Seed (optional) — used by `pnpm --filter @wizer/api db:seed`
# -----------------------------------------------------------------------------
SEED_SUPERADMIN_EMAIL=superadmin@wizer.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026Admin
SEED_SUPERADMIN_NAME=Platform Super Admin
SEED_COMPANY_NAME=Demo Company
SEED_COMPANYADMIN_PASSWORD=ChangeMe!2026Company

# --- Human verification (public signup + demo forms) -------------------------
# The public trial-signup endpoint creates a company, an owner and a
# subscription with NO authentication. CAPTCHA_SECRET is REQUIRED in production
# — the API refuses to boot without it rather than serve an unprotected form.
# Its presence is also what turns captcha on; there is no separate flag.
CAPTCHA_PROVIDER=turnstile        # turnstile | recaptcha | hcaptcha
CAPTCHA_SECRET=

# Human-verification widget on the public signup/demo forms. PUBLIC by design —
# the site key is meant to be in the page. The matching CAPTCHA_SECRET is
# server-only and must never appear as a NEXT_PUBLIC_ variable.
# With no site key the widget renders nothing, which keeps local development
# working; the server still decides whether a token is required.
NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
