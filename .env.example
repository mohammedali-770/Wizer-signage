# =============================================================================
# MasterSignage — Environment Variables (example)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# See docs/environment-variables.md for a full reference of each variable.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Performance troubleshooting (all optional, safe to leave unset):
#   PERF_LOG_REQUESTS=true  -> log every request (method/path/status/ms); off by
#                              default (slow requests are warned regardless).
#   PERF_SLOW_MS=1000       -> request duration (ms) that triggers a SLOW warning.
#   PERF_LOG_QUERIES=true   -> log Prisma SQL + duration (NEVER params/values).
#   PERF_SLOW_QUERY_MS=50   -> query duration (ms) tagged as SLOW in query logs.
# PERF_LOG_REQUESTS=false
# PERF_LOG_QUERIES=false
# Public dashboard base URL — used to build links in emails (invites, resets).
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# API / Dashboard URLs & ports
# -----------------------------------------------------------------------------
# Bind address for the API. Default 0.0.0.0 so the nginx reverse proxy can
# reach it across the Docker network. Use 127.0.0.1 only for a local-only host.
API_HOST=0.0.0.0
API_PORT=3001
DASHBOARD_PORT=3000
# Public domain for nginx server_name + Let's Encrypt cert paths (no scheme).
# REQUIRED for the production Docker stack (nginx renders its config from this).
APP_DOMAIN=signage.example.com
# Internal base URL the dashboard server uses to reach the API.
API_URL=http://localhost:3001
# Public base URL exposed to the browser (must be reachable from the client).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Public marketing-site + dashboard base URLs (canonical links / redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000
# WebSocket upgrade path proxied to the API.
WS_PATH=/ws

# -----------------------------------------------------------------------------
# Marketing site / trial signups
# -----------------------------------------------------------------------------
# Self-service trial length (days) + the plan `code` assigned to new trials
# (must match a seeded plan; falls back to the cheapest active plan).
TRIAL_DAYS=14
DEFAULT_TRIAL_PLAN=starter
# Where "Book a Demo" lead notifications are sent (falls back to SMTP_FROM).
SALES_NOTIFY_EMAIL=sales@example.com

# -----------------------------------------------------------------------------
# Database / Supabase
# -----------------------------------------------------------------------------
# Pooled connection string (PgBouncer) for runtime queries.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/master_signage?schema=public
# Direct (non-pooled) connection string for migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/master_signage?schema=public
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Private Storage bucket for content files (Phase 4). Create it in Supabase Storage.
SUPABASE_STORAGE_BUCKET=media
# Local dev fallback storage dir (used only when Supabase Storage is not configured).
STORAGE_LOCAL_DIR=.storage

# -----------------------------------------------------------------------------
# Auth / JWT / Session  (REQUIRED — secrets must be >= 16 chars)
# -----------------------------------------------------------------------------
# Generate strong values, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
# Symmetric key used to encrypt secrets at rest (TOTP secrets). REQUIRED.
# Generate with `openssl rand -base64 32`.
ENCRYPTION_KEY=change-me-encryption-key-min-16-chars
# Issuer label shown in authenticator apps for 2FA.
TWO_FACTOR_ISSUER=MasterSignage

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="MasterSignage <no-reply@example.com>"
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Data retention / maintenance (Phase 10)
# -----------------------------------------------------------------------------
# Retention window (days) for telemetry/operational data. Financial records are
# never deleted. Run cleanup via cron: maintenance.cli.js all
RETENTION_DAYS=90
CONTENT_TRASH_RETENTION_DAYS=14
BACKUP_DIR=./backups

# -----------------------------------------------------------------------------
# Map provider
# -----------------------------------------------------------------------------
MAP_PROVIDER=maptiler
MAP_API_KEY=your-map-api-key

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Seed (optional) — used by `pnpm --filter @master-signage/api db:seed`
# -----------------------------------------------------------------------------
SEED_SUPERADMIN_EMAIL=superadmin@mastersignage.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026Admin
SEED_SUPERADMIN_NAME=Platform Super Admin
SEED_COMPANY_NAME=Demo Company
SEED_COMPANYADMIN_PASSWORD=ChangeMe!2026Company
