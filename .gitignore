# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
build/
coverage/

# Archive / packaged build artifacts
*.tar.gz
*.zip

# Local dev content storage (Phase 4 storage fallback adapter)
.storage/

# Turborepo
.turbo/

# TypeScript incremental build cache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (keep *.example templates tracked; never real env files)
.env
.env.*
!.env.example
!*.env.example
!**/.env.example
!**/*.env.production.example

# Android / Gradle
.gradle/
local.properties
*.apk
*.aab
captures/
.cxx/
# Keystores + signed release artifacts (build-android-release.sh output).
*.jks
*.keystore
keystore.properties
release-output/

# Per-host deploy history written by scripts/deploy.sh and read by
# scripts/rollback.sh. Machine-local state — the tags in it only mean anything
# on the host whose docker daemon holds those images.
.deploy-history

# IDEs / editors
.idea/
.vscode/*
!.vscode/extensions.json
*.iml

# OS
.DS_Store
Thumbs.db

# Host-mounted runtime downloads (e.g. Android player APK) — not source
/downloads/

# Claude Code local files — skills installed via `uipro init` are kept local
# (not vendored into the repo); local settings + runtime locks never committed.
.claude/
