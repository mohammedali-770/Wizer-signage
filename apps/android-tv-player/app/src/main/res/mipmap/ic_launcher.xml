    <path
        android:fillColor="#0E1116"
        android:pathData="M0,0h108v108h-108z" />
    <!-- Screen -->
    <path
        android:fillColor="#4F8CFF"
        android:pathData="M30,36 h48 a6,6 0 0 1 6,6 v24 a6,6 0 0 1 -6,6 h-48 a6,6 0 0 1 -6,-6 v-24 a6,6 0 0 1 6,-6 z" />
    <!-- Play triangle -->
    <path
        android:fillColor="#0E1116"
        android:pathData="M49,46 L49,62 L65,54 z" />
    <!-- Stand -->
    <path
        android:fillColor="#22D3A6"
        android:pathData="M48,72 h12 v6 h-12 z" />
</vector>
