<?xml version="1.0" encoding="utf-8"?>
<!--
    Production/default network posture. The Wizer API and content/storage
    endpoints are HTTPS-only; no release build carries a localhost/LAN HTTP
    exception. Development-only cleartext exceptions live under src/debug and
    therefore cannot be packaged into a release APK.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
