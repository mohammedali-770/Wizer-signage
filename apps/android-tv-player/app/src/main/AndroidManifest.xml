<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for content sync, pairing, and playback. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keep the screen on / device awake while signage is playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Auto-start the player after device reboot (kiosk behaviour, Phase 6/8). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground playback/sync service (later phases). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- This is an Android TV app: leanback is required, touchscreen is not. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@mipmap/ic_launcher"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WizerSignage"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.WizerSignage">

            <!-- Standard phone/tablet launcher (e.g. for development on a handset). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV launcher (home screen on TV devices). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Auto-start after reboot. `exported="true"` is REQUIRED for the system to
            deliver these broadcasts to a manifest-declared receiver; it does not open
            an attack surface for BOOT_COMPLETED (a protected broadcast only the OS may
            send), and the receiver validates the action and ignores everything else.
            QUICKBOOT_POWERON covers TV boxes whose vendor "fast boot" skips a full
            BOOT_COMPLETED. LOCKED_BOOT_COMPLETED is intentionally absent: the pairing
            state lives in credential-encrypted storage (unavailable pre-unlock) and TV
            devices without lock credentials deliver BOOT_COMPLETED promptly anyway.
            NOTE: after first install or a user force-stop, Android places the app in
            the stopped state and delivers NO boot broadcasts until the app is opened
            manually once (platform behaviour, cannot be bypassed).
        -->
        <receiver
            android:name=".system.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
