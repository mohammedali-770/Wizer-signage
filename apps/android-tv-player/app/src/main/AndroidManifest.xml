<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for content sync, pairing, playback, and OTA releases. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- OTA self-update. REQUEST_INSTALL_PACKAGES must be allowlisted once by
         device provisioning / the operator on normal Android TV. Wizer never
         opens the unknown-sources Settings UI itself. Android 12+ then supports
         requesting a no-user-action self-update; PackageInstaller can still
         refuse and Wizer records BLOCKED without interrupting playback. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Keep the screen on / device awake while signage is playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Auto-start the player after device reboot (kiosk behaviour, Phase 6/8). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground playback/sync service (later phases). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        Self-relaunch after an uncaught exception (see system/CrashRecovery). An
        exact alarm is what makes the screen come back in seconds instead of
        whenever the OS feels like it; on Android 12+ the grant may be withheld,
        and the handler falls back to an inexact alarm rather than failing.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- This is an Android TV app: leanback is required, touchscreen is not. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".SignageApplication"
        android:allowBackup="true"
        android:banner="@mipmap/ic_launcher"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WizerSignage"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.WizerSignage">

            <!-- Standard phone/tablet launcher (e.g. for development on a handset). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV launcher (home screen on TV devices). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Auto-start after reboot. `exported="false"` is the correct, safest setting:
            a manifest receiver still receives broadcasts sent by the *system* even when
            not exported, while no third-party app can reach it. Both actions here are
            delivered by system components at boot: BOOT_COMPLETED is a protected system
            broadcast, and QUICKBOOT_POWERON (vendor "fast boot" on some TV boxes) is
            fired by the OEM system boot process — so it is still received from that
            legitimate source, and the fact that it is not a *protected* action no
            longer matters because exported=false blocks every non-system, non-same-app
            sender. The receiver also validates the action and ignores everything else.
            LOCKED_BOOT_COMPLETED is intentionally absent: the pairing state lives in
            credential-encrypted storage (unavailable pre-unlock) and TV devices without
            lock credentials deliver BOOT_COMPLETED promptly anyway.
            NOTE: after first install or a user force-stop, Android places the app in
            the stopped state and delivers NO boot broadcasts until the app is opened
            manually once (platform behaviour, cannot be bypassed).
        -->
        <receiver
            android:name=".system.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
