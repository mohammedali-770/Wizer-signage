generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// WIZER SIGNAGE — ENUMS
// =============================================================================

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  CONTENT_MANAGER
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ScreenStatus {
  ONLINE
  OFFLINE
  WARNING
  DISABLED
  ARCHIVED
  UNPAIRED
  PAIRING
}

enum ScreenUse {
  MENU_LANDSCAPE
  OFFERS_PORTRAIT
  WAITING_AREA
  CASHIER_DISPLAY
  ENTRANCE
  INDOOR
  OUTDOOR
  GENERIC
}

enum Orientation {
  LANDSCAPE
  PORTRAIT
  UNKNOWN
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  REPLACED
}

enum LocationStatus {
  ACTIVE
  ARCHIVED
}

enum ContentType {
  IMAGE
  VIDEO
  PDF
  URL
  TEXT
}

enum ContentStatus {
  ACTIVE
  ARCHIVED
  TRASH
}

enum PlaylistStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ScheduleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ScheduleType {
  NORMAL
  CAMPAIGN
}

enum TargetType {
  COMPANY
  LOCATION
  SCREEN
  SCREEN_GROUP
  TAG
}

enum EmergencyStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum EmergencyType {
  FULLSCREEN_CONTENT
  MESSAGE_BANNER
  TEXT_OVERLAY
  BLANK_SCREEN
}

enum TagType {
  SCREEN
  CONTENT
  BOTH
}

enum ImportType {
  SCREENS
  CONTENT
  PLAYLISTS
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ReportType {
  PROOF_OF_PLAY
  CONTENT_USAGE
  SCREEN_UPTIME
  ALERT_SUMMARY
}

enum ReportFormat {
  CSV
  PDF
}

enum ReportDeliveryMethod {
  EMAIL
  DOWNLOAD
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationChannel {
  DASHBOARD
  EMAIL
}

enum AlertStatus {
  OPEN
  RESOLVED
}

enum DeviceCommandStatus {
  PENDING
  DELIVERED
  RUNNING
  SUCCEEDED
  FAILED
}

enum DeviceCommandType {
  FORCE_SYNC
  REFRESH_MANIFEST
  RESTART_PLAYBACK
  CLEAR_CACHE
  TAKE_SCREENSHOT
  REBOOT
}

enum ScreenshotType {
  MANUAL
  AUTO
}

enum BackupType {
  DATABASE
  OBJECT_STORAGE
}

enum BackupStatus {
  SUCCESS
  FAILED
}

enum ActivityActorType {
  USER
  SYSTEM
  DEVICE
}

// =============================================================================
// PLATFORM / TENANCY
// =============================================================================

model Company {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  status         CompanyStatus @default(ACTIVE)
  defaultLocale  String        @default("en") @map("default_locale")
  timezone       String        @default("UTC")
  logoUrl        String?       @map("logo_url")
  primaryColor   String?       @map("primary_color")
  customDomain   String?       @unique @map("custom_domain")
  settings       Json          @default("{}")
  fallbackContentId String?    @map("fallback_content_id")
  defaultKioskPinHash String?  @map("default_kiosk_pin_hash")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  users                User[]
  locations            Location[]
  screens              Screen[]
  screenGroups         ScreenGroup[]
  content              Content[]
  playlists            Playlist[]
  schedules            Schedule[]
  emergencyBroadcasts  EmergencyBroadcast[]
  tags                 Tag[]
  importJobs           ImportJob[]
  reportSchedules      ScheduledReport[]
  notifications        Notification[]
  alerts               Alert[]
  activityLogs         ActivityLog[]
  subscription         Subscription?
  billingInvoices      BillingInvoice[]
  proofOfPlays         ProofOfPlay[]
  backupRecords        BackupRecord[]

  @@map("companies")
}

model User {
  id                 String     @id @default(uuid())
  companyId          String?    @map("company_id")
  email              String     @unique
  name               String
  passwordHash       String     @map("password_hash")
  role               UserRole
  status             UserStatus @default(ACTIVE)
  locale             String     @default("en")
  twoFactorSecret    String?    @map("two_factor_secret")
  twoFactorEnabled   Boolean    @default(false) @map("two_factor_enabled")
  twoFactorVerifiedAt DateTime? @map("two_factor_verified_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime?  @map("locked_until")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  company                 Company?                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emergencyBroadcasts     EmergencyBroadcast[]     @relation("EmergencyCreatedBy")
  reportSchedules         ScheduledReport[]        @relation("ReportCreatedBy")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  activityLogs            ActivityLog[]
  createdImports          ImportJob[]               @relation("ImportCreatedBy")

  @@index([companyId])
  @@index([status])
  @@map("users")
}

model RolePermission {
  id         String   @id @default(uuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([role, permission])
  @@map("role_permissions")
}

model Plan {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  priceMonthly Decimal? @db.Decimal(12, 2) @map("price_monthly")
  priceAnnual  Decimal? @db.Decimal(12, 2) @map("price_annual")
  currency    String   @default("SAR")
  limits      Json     @default("{}")
  features    Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                  String             @id @default(uuid())
  companyId           String             @unique @map("company_id")
  planId              String             @map("plan_id")
  status              SubscriptionStatus @default(TRIALING)
  currentPeriodStart  DateTime?          @map("current_period_start")
  currentPeriodEnd    DateTime?          @map("current_period_end")
  trialEndsAt         DateTime?          @map("trial_ends_at")
  gracePeriodEndsAt   DateTime?          @map("grace_period_ends_at")
  customLimits        Json?              @map("custom_limits")
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model BillingInvoice {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("SAR")
  status         String   @default("DRAFT")
  dueDate        DateTime? @map("due_date")
  paidAt         DateTime? @map("paid_at")
  description    String?
  externalRef    String?  @map("external_ref")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@map("billing_invoices")
}

// =============================================================================
// LOCATIONS & SCREENS
// =============================================================================

model Location {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  name        String
  code        String?
  description String?
  address     String?
  city        String?
  region      String?
  country     String?
  latitude    Decimal?       @db.Decimal(10, 7)
  longitude   Decimal?       @db.Decimal(10, 7)
  timezone    String?
  notes       String?
  status      LocationStatus @default(ACTIVE)
  workingHours Json?         @map("working_hours")
  fallbackContentId String?  @map("fallback_content_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  screens Screen[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("locations")
}

model Screen {
  id                       String       @id @default(uuid())
  companyId                String       @map("company_id")
  locationId               String?      @map("location_id")
  name                     String
  code                     String?
  description              String?
  use                      ScreenUse?
  orientation              Orientation  @default(LANDSCAPE)
  status                   ScreenStatus @default(UNPAIRED)
  audioEnabled             Boolean      @default(false) @map("audio_enabled")
  volume                   Int          @default(50)
  muted                    Boolean      @default(false)
  muteSchedule             Json?        @map("mute_schedule")
  workingHours             Json?        @map("working_hours")
  kioskEnabled             Boolean      @default(false) @map("kiosk_enabled")
  kioskPinHash             String?      @map("kiosk_pin_hash")
  autoStartEnabled         Boolean      @default(false) @map("auto_start_enabled")
  powerControlMode         String?      @map("power_control_mode")
  heartbeatIntervalSeconds Int          @default(60) @map("heartbeat_interval_seconds")
  fallbackContentId        String?      @map("fallback_content_id")
  appVersion               String?      @map("app_version")
  lastHeartbeatAt          DateTime?    @map("last_heartbeat_at")
  lastSyncAt               DateTime?    @map("last_sync_at")
  currentContentId         String?      @map("current_content_id")
  storageUsedBytes         BigInt?      @map("storage_used_bytes")
  storageTotalBytes        BigInt?      @map("storage_total_bytes")
  notes                    String?
  capabilities             Json         @default("{}")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  deletedAt                DateTime?    @map("deleted_at")

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location     Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  device       Device?
  groups       ScreenGroupMember[]
  tags         ScreenTag[]
  scheduleTargets ScheduleTarget[]
  emergencyTargets EmergencyTarget[]
  heartbeats   Heartbeat[]
  events       DeviceEvent[]
  commands     DeviceCommand[]
  screenshots  Screenshot[]
  alerts       Alert[]
  proofOfPlays ProofOfPlay[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, locationId])
  @@index([lastHeartbeatAt])
  @@map("screens")
}

model ScreenGroup {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members ScreenGroupMember[]
  scheduleTargets ScheduleTarget[]
  emergencyTargets EmergencyTarget[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("screen_groups")
}

model ScreenGroupMember {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  screenId  String   @map("screen_id")
  createdAt DateTime @default(now()) @map("created_at")

  group  ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  screen Screen      @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@unique([groupId, screenId])
  @@index([screenId])
  @@map("screen_group_members")
}

model Device {
  id             String       @id @default(uuid())
  screenId       String       @unique @map("screen_id")
  deviceId       String       @unique @map("device_id")
  tokenHash      String       @map("token_hash")
  platform       String?
  modelName      String?      @map("model_name")
  osVersion      String?      @map("os_version")
  appVersion     String?      @map("app_version")
  status         DeviceStatus @default(ACTIVE)
  pairedAt       DateTime     @default(now()) @map("paired_at")
  lastSeenAt     DateTime?    @map("last_seen_at")
  syncStatus     String?
  syncProgress   Int?         @map("sync_progress")
  lastSyncAt     DateTime?    @map("last_sync_at")
  lastSyncError  String?      @map("last_sync_error")
  manifestVersion String?     @map("manifest_version")
  manifestSource String?      @map("manifest_source")
  cachedAssets   Int?         @map("cached_assets")
  requiredAssets Int?         @map("required_assets")
  failedDownloads Int?        @map("failed_downloads")
  cacheSizeBytes BigInt?      @map("cache_size_bytes")
  availableStorageBytes BigInt? @map("available_storage_bytes")
  playbackState  String?      @map("playback_state")
  networkStatus  String?      @map("network_status")
  currentContentId String?    @map("current_content_id")
  lastHeartbeatAt DateTime?   @map("last_heartbeat_at")
  capabilities   Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lastSeenAt])
  @@map("devices")
}

model PairingCode {
  id         String   @id @default(uuid())
  code       String   @unique
  screenId   String?  @map("screen_id")
  deviceId   String   @map("device_id")
  secretHash String   @map("secret_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("pairing_codes")
}

// =============================================================================
// CONTENT LIBRARY
// =============================================================================

model Content {
  id               String        @id @default(uuid())
  companyId        String        @map("company_id")
  title            String
  description      String?
  type             ContentType
  status           ContentStatus @default(ACTIVE)
  orientation      Orientation   @default(UNKNOWN)
  storageKey       String?       @map("storage_key")
  originalFileName String?       @map("original_file_name")
  fileSize         BigInt?       @map("file_size")
  mimeType         String?       @map("mime_type")
  checksum         String?
  url              String?
  textBody         String?       @map("text_body")
  durationSeconds  Int?          @map("duration_seconds")
  pageCount        Int?          @map("page_count")
  thumbnailKey     String?       @map("thumbnail_key")
  metadata         Json          @default("{}")
  expiresAt        DateTime?     @map("expires_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tags ContentTag[]
  playlistItems PlaylistItem[]
  emergencyBroadcasts EmergencyBroadcast[]
  proofOfPlays ProofOfPlay[]

  @@index([companyId, status])
  @@index([companyId, type])
  @@index([expiresAt])
  @@map("content")
}

// =============================================================================
// PLAYLISTS
// =============================================================================

model Playlist {
  id               String         @id @default(uuid())
  companyId        String         @map("company_id")
  title            String
  description      String?
  status           PlaylistStatus @default(DRAFT)
  defaultDurationSeconds Int       @default(10) @map("default_duration_seconds")
  loop             Boolean        @default(true)
  shuffle          Boolean        @default(false)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items PlaylistItem[]
  schedules Schedule[]
  emergencyBroadcasts EmergencyBroadcast[]
  proofOfPlays ProofOfPlay[]

  @@index([companyId, status])
  @@map("playlists")
}

model PlaylistItem {
  id              String   @id @default(uuid())
  playlistId      String   @map("playlist_id")
  contentId       String   @map("content_id")
  position        Int
  durationSeconds Int?     @map("duration_seconds")
  playFullVideo   Boolean  @default(false) @map("play_full_video")
  createdAt       DateTime @default(now()) @map("created_at")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  content  Content  @relation(fields: [contentId], references: [id])

  @@unique([playlistId, position])
  @@index([contentId])
  @@map("playlist_items")
}

// =============================================================================
// SCHEDULING
// =============================================================================

model Schedule {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  playlistId   String?        @map("playlist_id")
  name         String
  description  String?
  status       ScheduleStatus @default(DRAFT)
  scheduleType ScheduleType   @default(NORMAL) @map("schedule_type")
  priority     Int            @default(0)
  startDate    DateTime?      @map("start_date")
  endDate      DateTime?      @map("end_date")
  startTime    String?        @map("start_time")
  endTime      String?        @map("end_time")
  daysOfWeek   Int[]          @default([]) @map("days_of_week")
  isAllDay     Boolean        @default(true) @map("is_all_day")
  timezone     String?
  metadata     Json           @default("{}")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playlist Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  targets  ScheduleTarget[]
  proofOfPlays ProofOfPlay[]

  @@index([companyId, status])
  @@index([companyId, priority])
  @@index([startDate, endDate])
  @@map("schedules")
}

model ScheduleTarget {
  id         String     @id @default(uuid())
  scheduleId String     @map("schedule_id")
  targetType TargetType @map("target_type")
  targetId   String?    @map("target_id")
  createdAt  DateTime   @default(now()) @map("created_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([targetType, targetId])
  @@map("schedule_targets")
}

// =============================================================================
// EMERGENCY BROADCASTS
// =============================================================================

model EmergencyBroadcast {
  id               String          @id @default(uuid())
  companyId        String          @map("company_id")
  createdById      String          @map("created_by_id")
  title            String
  description      String?
  type             EmergencyType   @default(FULLSCREEN_CONTENT)
  status           EmergencyStatus @default(DRAFT)
  contentId        String?         @map("content_id")
  playlistId       String?         @map("playlist_id")
  message          String?
  priority         Int             @default(1000)
  startAt          DateTime?       @map("start_at")
  endAt            DateTime?       @map("end_at")
  activatedAt      DateTime?       @map("activated_at")
  endedAt          DateTime?       @map("ended_at")
  requireConfirmation Boolean      @default(false) @map("require_confirmation")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User     @relation("EmergencyCreatedBy", fields: [createdById], references: [id])
  content   Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  playlist  Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  targets   EmergencyTarget[]
  proofOfPlays ProofOfPlay[]

  @@index([companyId, status])
  @@index([startAt, endAt])
  @@map("emergency_broadcasts")
}

model EmergencyTarget {
  id                   String     @id @default(uuid())
  emergencyBroadcastId String     @map("emergency_broadcast_id")
  targetType           TargetType @map("target_type")
  targetId             String?    @map("target_id")
  createdAt            DateTime   @default(now()) @map("created_at")

  emergencyBroadcast EmergencyBroadcast @relation(fields: [emergencyBroadcastId], references: [id], onDelete: Cascade)

  @@index([emergencyBroadcastId])
  @@index([targetType, targetId])
  @@map("emergency_targets")
}

// =============================================================================
// TAGS
// =============================================================================

model Tag {
  id          String  @id @default(uuid())
  companyId   String  @map("company_id")
  name        String
  type        TagType @default(BOTH)
  color       String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  screens ScreenTag[]
  content ContentTag[]

  @@unique([companyId, name, type])
  @@index([companyId])
  @@map("tags")
}

model ScreenTag {
  id        String   @id @default(uuid())
  screenId  String   @map("screen_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([screenId, tagId])
  @@index([tagId])
  @@map("screen_tags")
}

model ContentTag {
  id        String   @id @default(uuid())
  contentId String   @map("content_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contentId, tagId])
  @@index([tagId])
  @@map("content_tags")
}

// =============================================================================
// IMPORTS
// =============================================================================

model ImportJob {
  id             String       @id @default(uuid())
  companyId      String       @map("company_id")
  createdById    String       @map("created_by_id")
  type           ImportType
  status         ImportStatus @default(PENDING)
  fileName       String       @map("file_name")
  fileStorageKey String?      @map("file_storage_key")
  totalRows      Int          @default(0) @map("total_rows")
  processedRows  Int          @default(0) @map("processed_rows")
  successRows    Int          @default(0) @map("success_rows")
  failedRows     Int          @default(0) @map("failed_rows")
  errorReportKey String?      @map("error_report_key")
  metadata       Json         @default("{}")
  startedAt      DateTime?    @map("started_at")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ImportCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, status])
  @@map("import_jobs")
}

// =============================================================================
// REPORTING
// =============================================================================

model ScheduledReport {
  id             String               @id @default(uuid())
  companyId      String               @map("company_id")
  createdById    String               @map("created_by_id")
  name           String
  reportType     ReportType           @map("report_type")
  format         ReportFormat         @default(CSV)
  deliveryMethod ReportDeliveryMethod @default(EMAIL) @map("delivery_method")
  recipients     String[]             @default([])
  schedule       String
  timezone       String               @default("UTC")
  filters        Json                 @default("{}")
  isActive       Boolean              @default(true) @map("is_active")
  lastRunAt      DateTime?            @map("last_run_at")
  nextRunAt      DateTime?            @map("next_run_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ReportCreatedBy", fields: [createdById], references: [id])
  runs      ReportRun[]

  @@index([companyId, isActive])
  @@index([nextRunAt])
  @@map("scheduled_reports")
}

model ReportRun {
  id                String   @id @default(uuid())
  scheduledReportId String   @map("scheduled_report_id")
  status            String
  fileKey           String?  @map("file_key")
  error             String?
  startedAt         DateTime @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")

  scheduledReport ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)

  @@index([scheduledReportId])
  @@index([status])
  @@map("report_runs")
}

model ProofOfPlay {
  id                   String   @default(uuid())
  companyId            String   @map("company_id")
  screenId             String   @map("screen_id")
  contentId            String?  @map("content_id")
  playlistId           String?  @map("playlist_id")
  scheduleId           String?  @map("schedule_id")
  emergencyBroadcastId String?  @map("emergency_broadcast_id")
  startedAt            DateTime @map("started_at")
  endedAt              DateTime? @map("ended_at")
  durationMs            Int?     @map("duration_ms")
  completed             Boolean  @default(false)
  playbackSessionId     String?  @map("playback_session_id")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  screen             Screen              @relation(fields: [screenId], references: [id], onDelete: Cascade)
  content            Content?            @relation(fields: [contentId], references: [id], onDelete: SetNull)
  playlist           Playlist?           @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  schedule           Schedule?           @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  emergencyBroadcast EmergencyBroadcast? @relation(fields: [emergencyBroadcastId], references: [id], onDelete: SetNull)

  @@id([id, startedAt])
  @@index([companyId, startedAt])
  @@index([screenId, startedAt])
  @@index([contentId, startedAt])
  @@index([playlistId, startedAt])
  @@index([scheduleId, startedAt])
  @@index([emergencyBroadcastId, startedAt])
  @@map("proof_of_plays")
}

// =============================================================================
// MONITORING, ALERTS, NOTIFICATIONS
// =============================================================================

model Heartbeat {
  id              String   @default(uuid())
  screenId        String   @map("screen_id")
  deviceId        String?  @map("device_id")
  ipAddress       String?  @map("ip_address")
  appVersion      String?  @map("app_version")
  osVersion       String?  @map("os_version")
  deviceModel     String?  @map("device_model")
  cpuUsage        Float?   @map("cpu_usage")
  memoryUsage     Float?   @map("memory_usage")
  storageUsed     BigInt?  @map("storage_used")
  storageTotal    BigInt?  @map("storage_total")
  temperature     Float?
  networkStatus   String?  @map("network_status")
  playbackState   String?  @map("playback_state")
  currentContentId String? @map("current_content_id")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([screenId, createdAt])
  @@index([createdAt])
  @@map("heartbeats")
}

model DeviceEvent {
  id        String   @id @default(uuid())
  screenId  String   @map("screen_id")
  eventType String   @map("event_type")
  severity  NotificationSeverity @default(INFO)
  message   String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@index([screenId, createdAt])
  @@index([eventType, createdAt])
  @@map("device_events")
}

model DeviceCommand {
  id          String              @id @default(uuid())
  screenId    String              @map("screen_id")
  commandType DeviceCommandType   @map("command_type")
  status      DeviceCommandStatus @default(PENDING)
  payload     Json                @default("{}")
  requestedAt DateTime            @default(now()) @map("requested_at")
  deliveredAt DateTime?           @map("delivered_at")
  startedAt   DateTime?           @map("started_at")
  completedAt DateTime?           @map("completed_at")
  error       String?
  createdAt   DateTime            @default(now()) @map("created_at")

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@index([screenId, status])
  @@index([createdAt])
  @@map("device_commands")
}

model Screenshot {
  id          String         @id @default(uuid())
  screenId    String         @map("screen_id")
  commandId   String?        @map("command_id")
  type        ScreenshotType @default(MANUAL)
  storageKey  String         @map("storage_key")
  fileSize    BigInt?        @map("file_size")
  width       Int?
  height      Int?
  capturedAt  DateTime       @map("captured_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@index([screenId, capturedAt])
  @@map("screenshots")
}

model Alert {
  id         String               @id @default(uuid())
  companyId  String               @map("company_id")
  screenId   String?              @map("screen_id")
  type       String
  severity   NotificationSeverity @default(WARNING)
  status     AlertStatus          @default(OPEN)
  title      String
  message    String?
  metadata   Json                 @default("{}")
  dedupeKey  String?              @unique @map("dedupe_key")
  openedAt   DateTime             @default(now()) @map("opened_at")
  resolvedAt DateTime?            @map("resolved_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  screen  Screen?  @relation(fields: [screenId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([screenId])
  @@index([severity])
  @@map("alerts")
}

model Notification {
  id         String               @id @default(uuid())
  companyId  String               @map("company_id")
  userId     String               @map("user_id")
  type       String
  severity   NotificationSeverity @default(INFO)
  title      String
  message    String?
  metadata   Json                 @default("{}")
  channels   String[]             @default([])
  readAt     DateTime?            @map("read_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  eventType String              @map("event_type")
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@map("notification_preferences")
}

// =============================================================================
// BACKUPS & ACTIVITY LOGS
// =============================================================================

model BackupRecord {
  id          String       @id @default(uuid())
  companyId   String?      @map("company_id")
  type        BackupType
  status      BackupStatus
  location    String?
  sizeBytes   BigInt?      @map("size_bytes")
  error       String?
  startedAt   DateTime     @default(now()) @map("started_at")
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("backup_records")
}

model ActivityLog {
  id          String            @id @default(uuid())
  companyId   String?           @map("company_id")
  userId      String?           @map("user_id")
  actorType   ActivityActorType @default(USER) @map("actor_type")
  actorId     String?           @map("actor_id")
  action      String
  category    String
  targetType  String?           @map("target_type")
  targetId    String?           @map("target_id")
  description String?
  metadata    Json              @default("{}")
  ipAddress   String?           @map("ip_address")
  userAgent   String?           @map("user_agent")
  createdAt   DateTime          @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId])
  @@index([action])
  @@index([category])
  @@map("activity_logs")
}
