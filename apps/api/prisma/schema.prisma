// =============================================================================
// MasterSignage — Prisma schema
// Multi-tenant digital signage SaaS. Backing store: Supabase Postgres.
//
// DESIGN NOTES
//  - Shared-database / shared-schema multi-tenancy. Every tenant-owned table
//    carries `companyId` and is ALWAYS queried scoped by it (see
//    docs/multi-tenancy.md). Tables marked [GLOBAL] are platform-level.
//  - Phase 1 implements the runtime modules for Identity/Auth/Tenancy only.
//    The full product domain (fleet, content, scheduling, telemetry, billing,
//    integrations) is modelled here so the schema supports the whole product
//    from day one; those tables get their service/controller layers in later
//    phases. No data is lost to a future migration.
//  - "Pointer" columns that reference operational state (current/fallback
//    content, current playlist) are kept as plain String IDs (soft references)
//    to avoid a tangle of back-relations; structural ownership uses real FKs.
//  - Soft delete via `deletedAt` on long-lived tenant entities.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Enums
// =============================================================================

/// Platform-wide user roles (mirrors @master-signage/types UserRole).
enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  LOCATION_MANAGER
  CONTENT_MANAGER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
  LOCKED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  PENDING
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ScreenStatus {
  UNPAIRED
  PAIRING
  ONLINE
  OFFLINE
  WARNING
  DISABLED
  ARCHIVED
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum Orientation {
  LANDSCAPE
  PORTRAIT
  UNKNOWN
}

/// Intended use of a screen (drives default content/orientation hints).
enum ScreenUse {
  MENU_LANDSCAPE
  OFFERS_PORTRAIT
  WAITING_AREA
  CASHIER_DISPLAY
  ENTRANCE
  INDOOR
  OUTDOOR
  GENERIC
}

enum PairingStatus {
  PENDING
  CLAIMED
  EXPIRED
  REVOKED
}

/// Lifecycle of a paired player Device (Phase 6).
/// PENDING = dashboard claimed the code, awaiting the device to collect its token;
/// ACTIVE = token issued and in use; REVOKED = unpaired (token invalidated).
enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

/// Latest offline-cache / smart-sync state a device reports (Phase 7). Not a
/// heartbeat — just the most recent sync snapshot.
enum SyncStatus {
  IDLE
  SYNCING
  READY
  PARTIAL
  FAILED
  OFFLINE_PLAYBACK
}

/// Remote device commands a dashboard issues to a player (Phase 8).
enum DeviceCommandType {
  FORCE_SYNC
  REFRESH_MANIFEST
  RESTART_PLAYBACK
  CLEAR_CACHE
  TAKE_SCREENSHOT
  REBOOT_DEVICE
  UNPAIR_DEVICE
  RELOAD_CONFIG
}

/// Lifecycle of a remote device command (Phase 8).
enum DeviceCommandStatus {
  PENDING
  DELIVERED
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum TagType {
  SCREEN
  CONTENT
  BOTH
}

/// Content asset kinds. PLAYLIST is modelled as its own table, not here.
enum ContentType {
  IMAGE
  VIDEO
  PDF
  URL
  TEXT
}

enum ContentStatus {
  ACTIVE
  ARCHIVED
  TRASH
  DELETED
}

enum ScheduleTargetType {
  SCREEN
  SCREEN_GROUP
  LOCATION
  COMPANY
}

/// Conceptual global precedence ladder for what plays on a screen (highest →
/// lowest): EMERGENCY > HIGH > CAMPAIGN > NORMAL > FALLBACK. Retained for
/// documentation and the future Emergency Broadcast layer. Phase 5 schedules
/// use the numeric `Schedule.priority` (higher wins) + `Schedule.scheduleType`
/// for ordering; see docs/advanced-scheduling.md.
enum SchedulePriority {
  EMERGENCY
  HIGH
  CAMPAIGN
  NORMAL
  FALLBACK
}

/// Lifecycle of a Playlist (Phase 5).
enum PlaylistStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Lifecycle of a Schedule (Phase 5).
enum ScheduleStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Schedule kind. CAMPAIGN outranks NORMAL when two schedules share the same
/// numeric priority (Phase 5 conflict resolution).
enum ScheduleType {
  NORMAL
  CAMPAIGN
}

/// Lifecycle of an Emergency Broadcast (Phase 9). DRAFT → (ACTIVE | SCHEDULED)
/// → PAUSED ⇄ ACTIVE → ENDED → ARCHIVED. Only ACTIVE (within its time window)
/// pre-empts schedules in the resolver.
enum EmergencyBroadcastStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

/// What an Emergency Broadcast plays (Phase 9).
enum EmergencyBroadcastType {
  CONTENT
  PLAYLIST
  TEXT
  URL
}

enum ScreenshotType {
  AUTO
  MANUAL
}

/// Why an item played (Phase 9 proof-of-play) — mirrors the resolver's manifest
/// source. EMERGENCY for emergency-broadcast pre-emption; NONE for system/idle.
enum PlaybackSourceType {
  SCHEDULE
  FALLBACK
  EMERGENCY
  NONE
}

/// How the bytes reached the screen (Phase 9 proof-of-play).
enum PlaybackSourceKind {
  LOCAL_CACHE
  STREAMING_SIGNED_URL
  TEXT
  URL
  PDF
  UNKNOWN
}

/// Lifecycle of a single item playback (Phase 9 proof-of-play). STARTED on
/// open; one terminal state per playback session thereafter.
enum ProofOfPlayStatus {
  STARTED
  COMPLETED
  FAILED
  SKIPPED
  INTERRUPTED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ApkChannel {
  STABLE
  BETA
}

enum BackupType {
  DATABASE
  STORAGE
  FULL
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

// --- Phase 10: notifications, alerts, imports, reports ----------------------

/// Lifecycle of an operational Alert (Phase 10).
enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

/// Delivery channel for a user's notification preference (Phase 10).
enum NotificationChannel {
  DASHBOARD
  EMAIL
}

/// Outcome of an outbound email send (Phase 10 EmailDeliveryLog).
enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// Administrative entity a bulk import targets (Phase 10).
enum ImportType {
  COMPANY
  LOCATION
  SCREEN
  USER
  SCREEN_GROUP
  TAG
}

/// Lifecycle of a bulk ImportJob (Phase 10).
enum ImportStatus {
  UPLOADED
  VALIDATED
  COMMITTED
  FAILED
  CANCELLED
}

/// Dataset a scheduled/export report covers (Phase 10).
enum ReportType {
  PROOF_OF_PLAY
  SCREEN_HEALTH
  ALERTS
  ACTIVITY_LOGS
  BILLING
}

/// Output format for a report (Phase 10). PDF renders as print-optimized HTML.
enum ReportFormat {
  CSV
  XLSX
  PDF
}

/// Cadence of a scheduled report (Phase 10).
enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// Outcome of a scheduled-report delivery (Phase 10).
enum ReportDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// =============================================================================
// Identity, tenancy & access  (Phase 1 — implemented)
// =============================================================================

/// [GLOBAL] Future reseller / partner account that owns a set of companies.
/// Designed-for but not active in v1 (white-label readiness).
model Reseller {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  status    CompanyStatus @default(ACTIVE)
  companies Company[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("resellers")
}

/// The tenant root: one customer organization. `id` is the `companyId` used
/// for scoping across every tenant-owned table.
model Company {
  id     String        @id @default(uuid())
  name   String
  slug   String        @unique
  status CompanyStatus @default(ACTIVE)

  // Localization defaults.
  defaultLocale String @default("en")
  timezone      String @default("UTC")

  // White-label / branding (future-ready; not active in v1).
  logoUrl          String?
  primaryColor     String?
  customDomain     String? @unique
  brandedEmailFrom String?

  // Reseller / partner ownership (future-ready).
  resellerId String?
  reseller   Reseller? @relation(fields: [resellerId], references: [id], onDelete: SetNull)

  // Operational defaults.
  defaultKioskPinHash String? // Argon2 hash of the company default kiosk PIN (never raw)
  fallbackContentId   String? // soft reference -> Content (company-level fallback)
  settings            Json    @default("{}")

  // Suspension (Super Admin action; Phase 2 UI).
  suspendedAt     DateTime?
  suspendedReason String?

  // Relations.
  users               User[]
  invitations         Invitation[]
  sessions            Session[]
  activityLogs        ActivityLog[]
  locations           Location[]
  screenGroups        ScreenGroup[]
  tags                Tag[]
  pairingCodes        PairingCode[]
  devices             Device[]
  deviceCommands      DeviceCommand[]
  screens             Screen[]
  contents            Content[]
  playlists           Playlist[]
  schedules           Schedule[]
  emergencyBroadcasts EmergencyBroadcast[]
  heartbeats          Heartbeat[]
  screenshots         Screenshot[]
  proofOfPlays        ProofOfPlay[]
  subscription        Subscription?
  invoices            Invoice[]
  notifications       Notification[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  alerts              Alert[]
  emailDeliveryLogs   EmailDeliveryLog[]
  importJobs          ImportJob[]
  scheduledReports    ScheduledReport[]
  scheduledReportDeliveries ScheduledReportDelivery[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([resellerId])
  @@index([status])
  @@map("companies")
}

/// A dashboard user. SUPER_ADMIN users are platform-level (companyId = null).
model User {
  id        String   @id @default(uuid())
  companyId String? // null only for SUPER_ADMIN (platform-level)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email        String     @unique
  name         String
  passwordHash String? // null while INVITED (set on invite acceptance)
  role         UserRole   @default(VIEWER)
  status       UserStatus @default(INVITED)
  locale       String?

  // Security / lifecycle.
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  mustResetPassword Boolean   @default(false)

  // Two-factor authentication.
  twoFactorEnabled       Boolean @default(false)
  twoFactorSecret        String? // AES-256-GCM encrypted TOTP secret
  twoFactorPendingSecret String? // encrypted secret during enrollment
  twoFactorEnforced      Boolean @default(false) // company-enforced for this user

  // Relations.
  sessions            Session[]
  invitationsSent     Invitation[]         @relation("InvitationInvitedBy")
  backupCodes         BackupCode[]
  twoFactorChallenges TwoFactorChallenge[]
  passwordHistory     PasswordHistory[]
  passwordResetTokens PasswordResetToken[]
  loginEvents         LoginEvent[]
  activityLogs        ActivityLog[]        @relation("ActivityLogActor")
  locations           UserLocation[]
  notifications       Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([role])
  @@index([status])
  @@map("users")
}

/// Location-scoping for LOCATION_MANAGER users (assigned locations only).
model UserLocation {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, locationId])
  @@index([locationId])
  @@map("user_locations")
}

/// An authenticated session. Drives inactivity timeout, active-sessions view,
/// remote termination, and refresh-token rotation.
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  refreshTokenHash String // sha256(refresh token); rotated on refresh
  userAgent        String?
  ip               String?
  mfaSatisfied     Boolean @default(false)

  lastActiveAt  DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

/// Login attempts (success + failure) for lockout counting, audit and
/// suspicious-login detection.
model LoginEvent {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId  String?
  email      String
  success    Boolean
  reason     String?
  ip         String?
  userAgent  String?
  suspicious Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_events")
}

/// Recent password hashes to prevent immediate password reuse.
model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("password_history")
}

/// Single-use, time-limited password reset token (stored hashed).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One-time 2FA backup recovery code (stored hashed).
model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("backup_codes")
}

/// Server-side state for the 2FA login step-up challenge. Makes the short-lived
/// challenge token genuinely single-use: it is consumed on the first successful
/// verification so a replayed (challengeToken, code) pair is rejected even
/// within the token's lifetime.
model TwoFactorChallenge {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

/// A pending invite to join a company (3-day expiry, single-use token).
model Invitation {
  id          String           @id @default(uuid())
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole
  invitedById String?
  invitedBy   User?            @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  locationIds String[] // optional location scope for LOCATION_MANAGER invites
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([companyId])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

/// Audit / activity trail. companyId is null for platform-level Super Admin
/// actions; otherwise tenant-scoped.
model ActivityLog {
  id          String   @id @default(uuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?    @relation("ActivityLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String // e.g. "auth.login", "user.created"
  category    String // e.g. "AUTH", "USER", "COMPANY", "SECURITY"
  targetType  String?
  targetId    String?
  description String?
  metadata    Json     @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([actorId])
  @@index([action])
  @@index([category])
  @@index([createdAt])
  @@map("activity_logs")
}

// =============================================================================
// Fleet hierarchy  (Phase 3 — schema only)
// =============================================================================

model Location {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name              String
  code              String?
  description       String?
  address           String?
  city              String?
  region            String?
  country           String?
  latitude          Float?
  longitude         Float?
  timezone          String?
  notes             String?
  status            LocationStatus @default(ACTIVE)
  workingHours      Json? // weekly active-hours + outside-hours behaviour
  fallbackContentId String? // soft reference -> Content (location-level fallback)

  screens Screen[]
  users   UserLocation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@map("locations")
}

model ScreenGroup {
  id          String  @id @default(uuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String? // optional grouping category (e.g. "Drive-thru", "Lobby")

  members   ScreenGroupMember[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("screen_groups")
}

model ScreenGroupMember {
  screenId String
  screen   Screen      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  groupId  String
  group    ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([screenId, groupId])
  @@index([groupId])
  @@map("screen_group_members")
}

model Tag {
  id          String  @id @default(uuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  type        TagType @default(SCREEN)
  color       String?
  description String?

  contents ContentTag[]
  screens  ScreenTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name, type])
  @@index([companyId])
  @@map("tags")
}

model Screen {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  name             String
  code             String?
  description      String?
  use              ScreenUse?   @default(GENERIC)
  orientation      Orientation  @default(UNKNOWN)
  status           ScreenStatus @default(UNPAIRED)
  deviceIdentifier String?      @unique

  // Pairing & sync state.
  pairedAt        DateTime?
  lastHeartbeatAt DateTime?
  lastSyncAt      DateTime?
  appVersion      String?

  // Audio.
  audioEnabled Boolean @default(true)
  volume       Int     @default(50)
  muted        Boolean @default(false)
  muteSchedule Json? // optional mute windows (placeholder; enforced device-side later)

  // Active hours / kiosk / device.
  workingHours     Json?
  kioskEnabled     Boolean @default(true)
  kioskPinHash     String? // Argon2 hash of the screen-specific kiosk exit PIN (never raw)
  autoStartEnabled Boolean @default(false)
  powerControlMode String? // desired power behaviour (placeholder)

  // Operational pointers (soft references -> Content / Playlist).
  fallbackContentId String?
  currentContentId  String?
  currentPlaylistId String?

  // Health & capability reporting.
  storageUsedBytes         BigInt?
  storageTotalBytes        BigInt?
  capabilities             Json? // { kiosk, autoStart, powerControl, screenshot }
  heartbeatIntervalSeconds Int     @default(60)

  latitude  Float?
  longitude Float?
  notes     String?

  groups         ScreenGroupMember[]
  tags           ScreenTag[]
  pairingCodes   PairingCode[]
  device         Device?
  deviceCommands DeviceCommand[]
  heartbeats     Heartbeat[]
  screenshots    Screenshot[]
  proofOfPlays   ProofOfPlay[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([locationId])
  @@index([status])
  @@map("screens")
}

model ScreenTag {
  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([screenId, tagId])
  @@index([tagId])
  @@map("screen_tags")
}

/// Short-lived pairing code shown by an unpaired device and entered by an admin
/// to bind it to a company/screen. Device-initiated (Phase 6): the player calls
/// /device/pairing/start to mint a code + private pairing secret; an admin enters
/// the code against a screen profile; the device collects its token via the
/// secret. companyId/screenId stay null until an admin claims the code.
model PairingCode {
  id                String        @id @default(uuid())
  code              String        @unique
  companyId         String?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  screenId          String?
  screen            Screen?       @relation(fields: [screenId], references: [id], onDelete: SetNull)
  status            PairingStatus @default(PENDING)
  deviceId          String? // device-generated stable id (claims back to this Device)
  pairingSecretHash String? // sha256 of the device's private pairing secret (status polling)
  deviceInfo        Json? // hardware/model info reported by the device
  createdById       String?
  expiresAt         DateTime
  claimedAt         DateTime?
  createdAt         DateTime      @default(now())

  @@index([companyId])
  @@index([status])
  @@map("pairing_codes")
}

/// A paired Android TV player bound to exactly one screen (Phase 6). The device
/// token is stored only as a sha256 hash; the raw token is shown to the device
/// once when it collects it. Unpairing revokes the token.
model Device {
  id              String       @id @default(uuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  screenId        String       @unique // one active device per screen
  screen          Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade)
  deviceId        String // device-generated stable id (from the pairing code)
  deviceTokenHash String? // sha256 of the issued device token (never the raw token)
  status          DeviceStatus @default(PENDING)
  platform        String?
  modelName       String?
  osVersion       String?
  appVersion      String?
  pairedAt        DateTime?
  unpairedAt      DateTime?
  lastSeenAt      DateTime?

  // Phase 7 — latest offline-cache / smart-sync status reported by the device.
  syncStatus            SyncStatus?
  manifestSource        String? // REMOTE | LOCAL_CACHE
  manifestVersion       String? // manifest generatedAt / hash the device last synced
  requiredAssets        Int?
  cachedAssets          Int?
  failedDownloads       Int?
  cacheSizeBytes        BigInt?
  availableStorageBytes BigInt?
  lastSyncAt            DateTime?
  lastSyncError         String?
  syncMetadata          Json? // e.g. { failedAssetIds: [...] }

  // Phase 8 — latest telemetry snapshot reported via heartbeat (fast dashboard read).
  playbackState     String? // PLAYING | IDLE | BUFFERING | ERROR | OFFLINE_PLAYBACK
  networkStatus     String? // ONLINE | OFFLINE | METERED
  currentContentId  String?
  currentPlaylistId String?
  currentScheduleId String?
  uptimeSeconds     Int?
  lastHeartbeatAt   DateTime?

  commands DeviceCommand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([deviceId])
  @@index([deviceTokenHash])
  @@map("devices")
}

/// A remote command issued by the dashboard and collected by the device (Phase 8).
model DeviceCommand {
  id          String              @id @default(uuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  screenId    String
  screen      Screen              @relation(fields: [screenId], references: [id], onDelete: Cascade)
  deviceId    String? // null for a screen-level command (any device on the screen)
  device      Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  commandType DeviceCommandType
  status      DeviceCommandStatus @default(PENDING)
  payload     Json? // command parameters
  result      Json? // device-reported result
  error       String?
  issuedById  String?
  deliveredAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([companyId])
  @@index([screenId, status])
  @@index([deviceId])
  @@map("device_commands")
}

// =============================================================================
// Content & scheduling  (Phases 4-5 — schema only)
// =============================================================================

model Content {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        ContentType
  title       String
  description String?

  // Storage (Supabase Storage) / payload.
  storageKey       String? // companies/{companyId}/content/{contentId}/{filename}
  url              String? // external URL content, or public URL of stored asset
  fileSize         BigInt?
  mimeType         String?
  originalFileName String?
  checksum         String? // sha256 of the uploaded file
  pageCount        Int? // for PDFs (when available)
  textBody         String? // for TEXT announcements
  textStyle        Json? // optional display styling for TEXT content
  meta             Json    @default("{}")

  orientation     Orientation   @default(UNKNOWN)
  durationSeconds Int? // default display duration
  status          ContentStatus @default(ACTIVE)
  expiresAt       DateTime? // stops displaying after this instant
  archivedAt      DateTime?
  trashedAt       DateTime?
  createdById     String?
  updatedById     String?

  tags          ContentTag[]
  playlistItems PlaylistItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
  @@map("contents")
}

model ContentTag {
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@index([tagId])
  @@map("content_tags")
}

model Playlist {
  id          String         @id @default(uuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      PlaylistStatus @default(ACTIVE)
  createdById String?
  updatedById String?

  items     PlaylistItem[]
  schedules Schedule[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  @@index([companyId])
  @@index([status])
  @@map("playlists")
}

model PlaylistItem {
  id                     String   @id @default(uuid())
  playlistId             String
  playlist               Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  contentId              String
  content                Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  position               Int // 0-based playback order within the playlist
  durationSeconds        Int? // null => use content default (images/text/url/pdf)
  playFullVideo          Boolean  @default(false) // video: play full length (ignore durationSeconds)
  pdfPageDurationSeconds Int? // per-page dwell time for multi-page PDFs
  transitionType         String? // future-ready (e.g. "none", "fade")
  settings               Json     @default("{}") // per-item extras (itemSettings)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playlistId])
  @@index([contentId])
  @@map("playlist_items")
}

model Schedule {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  playlistId  String?
  playlist    Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  status       ScheduleStatus @default(ACTIVE)
  scheduleType ScheduleType   @default(NORMAL)
  priority     Int            @default(0) // higher wins; CAMPAIGN breaks ties over NORMAL

  startDate  DateTime?
  endDate    DateTime?
  startTime  String? // "HH:mm" local (omitted when isAllDay)
  endTime    String? // "HH:mm" local; endTime < startTime ⇒ overnight window
  isAllDay   Boolean   @default(false)
  daysOfWeek Int[] // 0=Sun .. 6=Sat (empty ⇒ every day)
  recurrence Json? // advanced recurrence rules (future-ready)
  timezone   String?

  createdById String?
  updatedById String?

  targets ScheduleTarget[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  @@index([companyId])
  @@index([playlistId])
  @@index([status])
  @@index([priority])
  @@map("schedules")
}

model ScheduleTarget {
  id         String             @id @default(uuid())
  scheduleId String
  schedule   Schedule           @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  targetType ScheduleTargetType
  targetId   String // soft reference (screen/group/location/company id)

  @@unique([scheduleId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("schedule_targets")
}

model EmergencyBroadcast {
  id            String                   @id @default(uuid())
  companyId     String
  company       Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  message       String? // TEXT body when broadcastType = TEXT
  url           String? // external URL when broadcastType = URL
  contentId     String? // soft reference -> Content (broadcastType = CONTENT)
  playlistId    String? // soft reference -> Playlist (broadcastType = PLAYLIST)
  contentType   ContentType?
  broadcastType EmergencyBroadcastType   @default(CONTENT)
  /// Orders simultaneous emergencies (higher wins). Any emergency still
  /// out-ranks every schedule; this only breaks ties between emergencies.
  priority      Int                      @default(100)
  status        EmergencyBroadcastStatus @default(DRAFT)
  startAt       DateTime?
  endAt         DateTime?
  stoppedAt     DateTime? // when manually/automatically ENDED
  createdById   String?
  updatedById   String?

  targets EmergencyBroadcastTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([companyId, status])
  @@map("emergency_broadcasts")
}

model EmergencyBroadcastTarget {
  id          String             @id @default(uuid())
  broadcastId String
  broadcast   EmergencyBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  targetType  ScheduleTargetType
  targetId    String

  @@unique([broadcastId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("emergency_broadcast_targets")
}

// =============================================================================
// Telemetry & reporting  (Phases 8-9 — schema only)
// =============================================================================

/// Heartbeat history (Phase 8). One row per heartbeat (90-day retention policy;
/// the cleanup job is Phase 10). The latest snapshot is also denormalized onto
/// Device/Screen for fast dashboard reads.
model Heartbeat {
  id                    String      @id @default(uuid())
  screenId              String
  screen                Screen      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  companyId             String
  company               Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceId              String?
  online                Boolean     @default(true)
  playbackState         String? // PLAYING | IDLE | BUFFERING | ERROR | OFFLINE_PLAYBACK
  networkStatus         String? // ONLINE | OFFLINE | METERED
  appVersion            String?
  deviceModel           String?
  osVersion             String?
  uptimeSeconds         Int?
  currentContentId      String?
  currentPlaylistId     String?
  currentScheduleId     String?
  manifestVersion       String?
  syncStatus            SyncStatus?
  cacheSizeBytes        BigInt?
  availableStorageBytes BigInt?
  storageUsedBytes      BigInt?
  storageTotalBytes     BigInt?
  lastError             String?
  payload               Json        @default("{}")
  createdAt             DateTime    @default(now())

  @@index([screenId])
  @@index([companyId])
  @@index([createdAt])
  @@map("heartbeats")
}

model Screenshot {
  id            String         @id @default(uuid())
  screenId      String
  screen        Screen         @relation(fields: [screenId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceId      String?
  commandId     String? // the TAKE_SCREENSHOT command that produced it, if any
  storageKey    String
  url           String?
  fileSizeBytes BigInt?
  mimeType      String?
  type          ScreenshotType @default(MANUAL)
  metadata      Json?
  takenAt       DateTime       @default(now())
  createdAt     DateTime       @default(now())

  @@index([screenId])
  @@index([companyId])
  @@index([takenAt])
  @@map("screenshots")
}

/// Proof-of-Play (Phase 9). ONE row per actual item playback, keyed by a
/// device-generated `playbackSessionId` (idempotent upsert). Derived ONLY from
/// real player events — never from heartbeat, sync status, or manifest
/// generation. companyId/screenId/deviceId/locationId are server-derived from
/// the device token; the Android payload is never trusted for tenancy.
model ProofOfPlay {
  id                   String             @id @default(uuid())
  companyId            String
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  screenId             String
  screen               Screen             @relation(fields: [screenId], references: [id], onDelete: Cascade)
  deviceId             String?
  locationId           String? // soft reference, derived from the screen
  // All content/playlist/schedule/emergency refs are SOFT (no FK): proof-of-play
  // is an immutable audit log, so a buffered event must still be accepted even if
  // the referenced content was later hard-purged. Titles are resolved at read time.
  contentId            String?
  playlistId           String? // soft reference
  playlistItemId       String? // soft reference
  scheduleId           String? // soft reference
  emergencyBroadcastId String? // soft reference -> EmergencyBroadcast
  sourceType           PlaybackSourceType @default(NONE)
  playbackSource       PlaybackSourceKind @default(UNKNOWN)
  contentType          ContentType?
  startedAt            DateTime
  endedAt              DateTime?
  durationMs           Int?
  expectedDurationMs   Int?
  status               ProofOfPlayStatus  @default(STARTED)
  failureReason        String?
  manifestVersion      String?
  /// Device-generated id, unique per item playback — the idempotency key.
  playbackSessionId    String             @unique
  itemSequence         Int?
  offlinePlayback      Boolean            @default(false)
  metadata             Json               @default("{}")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([companyId, startedAt])
  @@index([screenId, startedAt])
  @@index([contentId])
  @@index([emergencyBroadcastId])
  @@index([status])
  @@map("proof_of_plays")
}

// =============================================================================
// Billing  (Phase 2/10 — schema only; no payment gateway in v1)
// =============================================================================

/// [GLOBAL] Subscription plan/tier definition.
model Plan {
  id              String          @id @default(uuid())
  name            String
  code            String          @unique
  description     String?
  priceMonthly    Decimal         @default(0) @db.Decimal(12, 2)
  priceYearly     Decimal?        @db.Decimal(12, 2)
  currency        String          @default("USD")
  billingInterval BillingInterval @default(MONTHLY)
  trialDays       Int             @default(0)
  isActive        Boolean         @default(true)
  isPublic        Boolean         @default(true)
  /// Plan limits: maxCompanies (reseller-ready), maxScreens, maxLocations,
  /// maxUsers, storageGb, maxFileSizeMb, autoScreenshotsPerDay,
  /// scheduledReports, dataRetentionDays, apiRequestsPerDay, webhooks.
  /// Stored as JSON; a value of null means "unlimited". Typed via PlanLimitsDto.
  limits          Json            @default("{}")

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid())
  companyId String             @unique
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status    SubscriptionStatus @default(TRIALING)

  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  gracePeriodEndsAt  DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  number         String        @unique
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("USD")
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal?      @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  lineItems      Json          @default("[]")
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

// =============================================================================
// Platform & integration  (Phase 10 — schema only)
// =============================================================================

model Notification {
  id        String               @id @default(uuid())
  companyId String?
  company   Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String?
  data      Json                 @default("{}")
  channels  String[] // e.g. ["in_app", "email"]
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime             @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model ApiKey {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  prefix      String    @unique
  hashedKey   String
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  disabledAt  DateTime?
  createdById String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("api_keys")
}

model Webhook {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url         String
  secret      String
  events      String[]
  description String?
  isActive    Boolean  @default(true)

  deliveries WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String                @id @default(uuid())
  webhookId    String
  webhook      Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  companyId    String
  event        String
  payload      Json                  @default("{}")
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?
  responseBody String?
  nextRetryAt  DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime              @default(now())

  @@index([webhookId])
  @@index([companyId])
  @@index([status])
  @@map("webhook_deliveries")
}

/// [GLOBAL] Released Android TV player build (managed by Super Admin).
model ApkVersion {
  id           String     @id @default(uuid())
  versionName  String
  versionCode  Int        @unique
  channel      ApkChannel @default(STABLE)
  storageKey   String?
  url          String?
  fileSize     BigInt?
  checksum     String?
  releaseNotes String?
  isMandatory  Boolean    @default(false)
  minSupported Boolean    @default(false)
  createdById  String?
  createdAt    DateTime   @default(now())

  @@index([channel])
  @@map("apk_versions")
}

/// [GLOBAL] Operational record of a database/storage backup run.
model BackupRecord {
  id         String       @id @default(uuid())
  type       BackupType   @default(DATABASE)
  status     BackupStatus @default(RUNNING)
  location   String?
  sizeBytes  BigInt?
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  error      String?
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now())

  @@index([type])
  @@index([status])
  @@index([startedAt])
  @@map("backup_records")
}

// =============================================================================
// Operational automation  (Phase 10 — notifications, alerts, imports, reports)
// =============================================================================

/// An operational alert (Phase 10). companyId is null for platform/system-wide
/// alerts (Super Admin). Deduplicated while unresolved via `dedupeKey`; resolved
/// automatically when the underlying condition clears (e.g. screen back online).
model Alert {
  id               String               @id @default(uuid())
  companyId        String?
  company          Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  screenId         String? // soft reference
  deviceId         String? // soft reference
  type             String // e.g. screen.offline, sync.failed, subscription.expiring
  severity         NotificationSeverity @default(WARNING)
  status           AlertStatus          @default(OPEN)
  title            String
  message          String?
  /// Stable key for dedup while OPEN/ACKNOWLEDGED: companyId:screenId:type.
  dedupeKey        String?
  metadata         Json                 @default("{}")
  triggeredAt      DateTime             @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String? // soft reference -> User
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([companyId, status])
  @@index([dedupeKey])
  @@index([severity])
  @@index([createdAt])
  @@map("alerts")
}

/// Per-user opt in/out for a notification channel + event type (Phase 10).
/// Absence of a row = the system default for that channel/event.
model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String // soft reference -> User
  companyId String? // soft reference
  channel   NotificationChannel
  eventType String
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel, eventType])
  @@index([userId])
  @@map("notification_preferences")
}

/// Audit trail of every outbound email (Phase 10). A send failure must never
/// break the originating action — it is logged here, not thrown.
model EmailDeliveryLog {
  id                String              @id @default(uuid())
  companyId         String?
  company           Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipientEmail    String
  subject           String
  type              String? // event type / category
  status            EmailDeliveryStatus @default(PENDING)
  providerMessageId String?
  error             String?
  metadata          Json                @default("{}")
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("email_delivery_logs")
}

/// A bulk CSV/XLSX import job (Phase 10). companyId is null for Super Admin
/// Company imports (which mint fresh companies); otherwise tenant-scoped.
model ImportJob {
  id          String       @id @default(uuid())
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        ImportType
  status      ImportStatus @default(UPLOADED)
  fileName    String
  totalRows   Int          @default(0)
  validRows   Int          @default(0)
  invalidRows Int          @default(0)
  errors      Json         @default("[]")
  previewData Json         @default("[]")
  createdById String? // soft reference -> User
  committedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId])
  @@index([type])
  @@index([status])
  @@map("import_jobs")
}

/// A recurring report definition (Phase 10). The maintenance runner generates +
/// emails it when `nextRunAt` is due; a simple CLI/cron drives execution.
model ScheduledReport {
  id          String          @id @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  reportType  ReportType
  format      ReportFormat    @default(CSV)
  frequency   ReportFrequency @default(WEEKLY)
  recipients  Json            @default("[]") // array of email strings
  filters     Json            @default("{}")
  enabled     Boolean         @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdById String? // soft reference -> User

  deliveries ScheduledReportDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([enabled, nextRunAt])
  @@map("scheduled_reports")
}

/// One run/delivery of a scheduled report (Phase 10).
model ScheduledReportDelivery {
  id                String               @id @default(uuid())
  companyId         String
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scheduledReportId String
  scheduledReport   ScheduledReport      @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)
  status            ReportDeliveryStatus @default(PENDING)
  fileStorageKey    String?
  recipientEmails   Json                 @default("[]")
  error             String?
  sentAt            DateTime?
  createdAt         DateTime             @default(now())

  @@index([companyId])
  @@index([scheduledReportId])
  @@index([createdAt])
  @@map("scheduled_report_deliveries")
}
