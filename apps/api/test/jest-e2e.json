{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@wizer/types(.*)$": "<rootDir>/../../../packages/types/src$1",
    "^@wizer/shared(.*)$": "<rootDir>/../../../packages/shared/src$1"
  }
}
