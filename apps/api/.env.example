# =============================================================================
# Wizer Signage API — environment variables (example)
# Copy to .env and fill in real values for local development.
# Production secrets are injected by the deployment environment, never committed.
# See docs/environment-variables.md for the full canonical reference.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
# Public dashboard base URL — used to build email links (invites, resets).
APP_URL=http://localhost:3000

# --- HTTP / networking -----------------------------------------------------
API_PORT=3001
# Public base URL the API is reachable at (used for links, Swagger servers, etc.)
API_URL=http://localhost:3001
# Comma-separated list of allowed CORS origins. Use * to allow all (dev only).
CORS_ORIGINS=http://localhost:3000
# WebSocket path the realtime gateway is mounted on (Phase 1+).
WS_PATH=/ws

# --- Database (Supabase Postgres) ------------------------------------------
# Pooled connection string (PgBouncer) used by the application at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wizer_signage?schema=public
# Direct (non-pooled) connection string used by Prisma migrations (Phase 1).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/wizer_signage?schema=public

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Private Storage bucket for content files (Phase 4).
SUPABASE_STORAGE_BUCKET=media
# Local dev fallback storage dir (used only when Supabase Storage is not configured).
STORAGE_LOCAL_DIR=.storage

# --- Authentication / JWT (Phase 1, REQUIRED — secrets >= 16 chars) ---------
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
# Symmetric key used to encrypt 2FA TOTP secrets at rest. REQUIRED (>= 16 chars).
ENCRYPTION_KEY=change-me-encryption-key-min-16-chars
# Issuer label shown in authenticator apps for 2FA.
TWO_FACTOR_ISSUER=Wizer Signage

# --- Email / SMTP ----------------------------------------------------------
# When unset, emails are logged (dev) instead of sent. SMTP_PASS is an accepted
# alias for SMTP_PASSWORD; SMTP_SECURE=true forces TLS (else derived from port).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=change-me
SMTP_FROM="Wizer Signage <no-reply@wizer.sa>"
SMTP_SECURE=false

# --- Marketing site / trial signups ----------------------------------------
# Self-service trial length (days) and the plan `code` assigned to new trial
# tenants (must match a seeded plan; falls back to the cheapest active plan).
TRIAL_DAYS=14
DEFAULT_TRIAL_PLAN=starter
# Where "Book a Demo" lead notifications are sent (falls back to SMTP_FROM).
SALES_NOTIFY_EMAIL=sales@example.com

# --- Data retention / maintenance (Phase 10) -------------------------------
# Cleanup window (days) for telemetry/operational data (proof-of-play, heartbeat,
# screenshots, resolved alerts, email logs, report files). Financial records
# (invoices, subscriptions) are NEVER deleted. Content trash uses its own 14-day
# policy. Run via cron: `node apps/api/dist/maintenance/maintenance.cli.js all`.
RETENTION_DAYS=90
CONTENT_TRASH_RETENTION_DAYS=14

# --- Backups (Phase 10) ----------------------------------------------------
# Used by scripts/backup-db.sh; the script records a BackupRecord via the
# maintenance CLI so Super Admins see backup health in the dashboard.
BACKUP_DIR=./backups

# --- Maps ------------------------------------------------------------------
MAP_PROVIDER=google
MAP_API_KEY=your-map-api-key

# --- Cache / queues (optional) ---------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Seed (optional) — used by `pnpm db:seed` ------------------------------
SEED_SUPERADMIN_EMAIL=superadmin@wizer.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026Admin
SEED_SUPERADMIN_NAME=Platform Super Admin
SEED_COMPANY_NAME=Demo Company
SEED_COMPANYADMIN_PASSWORD=ChangeMe!2026Company
