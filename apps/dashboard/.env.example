# ---------------------------------------------------------------------------
# Wizer Signage Dashboard (Next.js) — environment example
# Copy to .env.local for local development. Do NOT commit real secrets.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Ports
DASHBOARD_PORT=3000

# API connectivity
# Server-side base URL the dashboard uses to reach the API (server components / route handlers).
API_URL=http://localhost:3001
# Browser-exposed base URL for the API (must be reachable from the client).
# PRODUCTION (Docker): Next.js inlines NEXT_PUBLIC_* at BUILD time, so this is
# passed as a build ARG to the dashboard image (compose: build.args.NEXT_PUBLIC_API_URL),
# e.g. https://wizer.sa/api — NOT read from runtime env. See docs/docker-production.md.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Public marketing-site + dashboard base URLs (canonical links, redirects).
# In this integrated setup both point at the same domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
# Alias of DASHBOARD_URL (the logged-in app). Kept for WIZER-spec compatibility.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WIZER brand (browser-exposed; safe defaults — no secrets).
NEXT_PUBLIC_COMPANY_NAME=WIZER
NEXT_PUBLIC_PRODUCT_NAME=Wizer Signage

# WebSocket path (proxied to the API by Nginx in production).

# Maps (client-side map rendering).
MAP_PROVIDER=maplibre
MAP_API_KEY=

# Human-verification widget on the public signup/demo forms. PUBLIC by design —
# the site key is meant to be in the page. The matching CAPTCHA_SECRET is
# server-only and must never appear as a NEXT_PUBLIC_ variable.
# With no site key the widget renders nothing, which keeps local development
# working; the server still decides whether a token is required.
NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
